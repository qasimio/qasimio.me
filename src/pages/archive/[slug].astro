---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SideRails from '../../components/SideRails.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import Icons from '../../components/Icons.astro';
import { projects } from '../../data/site';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---

<Layout title={`${project.title} — Qasim Sethar`} description={project.description}>
  <Nav />
  <SideRails />
  <main id="content" class="site-content">
    <section class="section section--first case">
      <p class="overline">03. / WORK / {project.category}</p>
      <h1>{project.title}</h1>
      <p class="case__lead">{project.description}</p>
      <div class="case__actions">
        {project.github && (
          <a class="big-button" href={project.github} target="_blank" rel="noopener noreferrer">
            <Icons name="github" size={18} />
            &nbsp; GitHub
          </a>
        )}
        {project.live && (
          <a class="big-button" href={project.live} target="_blank" rel="noopener noreferrer">
            <Icons name="external" size={18} />
            &nbsp; Open
          </a>
        )}
      </div>
      <div class="case__visual">
        <ProjectArt kind={project.visual} title={project.title} />
      </div>
    </section>
    <section class="section case__body">
      <div class="case__meta">
        <span>{project.year}</span>
        <span>{project.role}</span>
        <span>{project.category}</span>
      </div>
      <div class="case__content">
        <div>
          <p class="overline">The problem</p>
          <h2>Why I built it.</h2>
          <p>{project.problem}</p>
        </div>
        <div>
          <p class="overline">The build</p>
          <h2>What actually went into it.</h2>
          <p>{project.built}</p>
        </div>
        <div>
          <p class="overline">The hard part</p>
          <h2>Where it got interesting.</h2>
          <p>{project.hard}</p>
        </div>
        <blockquote>{project.quote}</blockquote>
        <div>
          <p class="overline">What stuck</p>
          <h2>What I learned.</h2>
          <p>{project.learned}</p>
        </div>
      </div>
    </section>
    <section class="section case__next">
      <a class="archive-link" href="/archive/">
        ← All work
      </a>
    </section>
  </main>
</Layout>
