---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SideRails from '../../components/SideRails.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';
---

<Layout title="Work — Qasim Sethar" description="Selected work and experiments by Qasim Sethar.">
  <Nav />
  <SideRails />
  <main id="content" class="site-content">
    <section class="section section--first page-head">
      <p class="overline">03. / WORK</p>
      <h1>Things I’ve built.</h1>
      <p>
        Products, systems, open source, experiments, and one or two things that should have stayed
        ideas.
      </p>
    </section>
    <section class="section section--tight">
      <ul class="projects-grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </ul>
    </section>
  </main>
</Layout>
