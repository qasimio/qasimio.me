---
import Shell from '../../layouts/Shell.astro';
import { site } from '../../data/site';
---

<Shell current="about" title="Contact — Qasim Sethar">
  <section class="page-section" style="padding-top:18px">
    <span class="eyebrow">CONTACT</span>
    <h1 style="margin:14px 0 0;color:var(--white);font-size:clamp(52px,7vw,92px);line-height:.98;letter-spacing:-.06em;font-weight:700">
      Talk to me.
    </h1>
    <p class="hero-copy">Email is easiest. I read it.</p>
    <div class="hero-actions">
      <a class="btn btn-solid" href={`mailto:${site.email}`}>
        Email {site.email} ↗
      </a>
    </div>
  </section>
  <section class="page-section">
    <div class="section-head">
      <span class="section-num">01</span>
      <span class="section-title">Other ways</span>
    </div>
    <div class="now-grid" style="grid-template-columns:repeat(2,1fr)">
      {site.socials
        .filter((s) => ['GitHub', 'LinkedIn', 'X', 'YouTube'].includes(s.label))
        .map((item) => (
          <a class="now-item" href={item.url} target="_blank" rel="noreferrer">
            <small>{item.short}</small>
            <strong>{item.label} ↗</strong>
          </a>
        ))}
    </div>
  </section>
</Shell>
