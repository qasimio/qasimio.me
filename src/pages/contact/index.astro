---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { site } from '../../data/site';
---

<Base title="Contact — Qasim Sethar" description="Contact Qasim Sethar at hello@qasimio.me.">
  <section class="contact-page site-shell">
    <div class="contact-head">
      <span class="eyebrow">LET'S TALK</span>
      <h1>
        What are you <em>working on?</em>
      </h1>
      <p>Tell me what you are building, fixing, testing, or trying to understand.</p>
    </div>
    <div class="contact-grid">
      <aside class="contact-aside">
        <span>EMAIL</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" data-copy-email>
          Copy email
        </button>
        <hr />
        <small>No funnel. No calendar gate. Email works.</small>
      </aside>
      <ContactForm />
    </div>
  </section>
</Base>
