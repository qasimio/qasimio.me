---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Contact"
  description="Contact Qasim Sethar for products, serious engineering, useful collaborations, and interesting problems."
>
  <section class="contact-page site-shell">
    <div class="contact-page__intro" data-reveal>
      <span class="eyebrow">04 / CONTACT</span>
      <h1>
        Bring a<br />
        <em>good problem.</em>
      </h1>
      <p>
        Products, engineering work, open-source collaboration, an unusual idea, or something you
        think I would care about.
      </p>
      <a class="contact-email" href="mailto:hello@qasimio.me">
        hello@qasimio.me <span>↗</span>
      </a>
    </div>

    <form class="contact-form" data-contact-form data-reveal>
      <label>
        Name
        <input name="name" type="text" autocomplete="name" placeholder="Your name" required />
      </label>
      <label>
        Email
        <input
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
        />
      </label>
      <label>
        What are you building?
        <textarea
          name="message"
          rows="8"
          placeholder="A product, problem, collaboration, idea..."
          required
        ></textarea>
      </label>
      <button type="submit">
        Compose email <span>↗</span>
      </button>
      <p>
        No database. No mystery submission bucket. It opens your email client with the message
        prepared.
      </p>
    </form>
  </section>
</Base>
