---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SideRails from '../../components/SideRails.astro';
import { timeline } from '../../data/site';
---

<Layout
  title="Timeline — Qasim Sethar"
  description="A chronological trail of projects, people, and work by Qasim Sethar."
>
  <Nav />
  <SideRails />
  <main id="content" class="site-content">
    <section class="section section--first page-head">
      <p class="overline">05. / TIMELINE</p>
      <h1>A trail, not a résumé.</h1>
      <p>
        The useful version of a career is not only where you worked. It is what changed because you
        kept building.
      </p>
    </section>
    <section class="section">
      <div class="timeline__track">
        {timeline.map((item) => (
          <article class="timeline__item" data-reveal>
            <span class="timeline__date">{item.date}</span>
            <h2 class="timeline__title">{item.title}</h2>
            <p class="timeline__meta">{item.meta}</p>
            <p class="timeline__body">{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
