---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import portrait from '../../assets/identity/qasim-portrait.jpg';
import { people, professional, recognition, site, timeline, workStyle } from '../../data/site';
---

<Base
  title="About — Qasim Sethar"
  description="About Qasim Sethar: software, products, people, and how he works."
>
  <section class="page-hero site-shell about-hero">
    <div class="page-hero-meta">
      <span>03 / ABOUT</span>
      <span>THE PERSON</span>
    </div>
    <h1>
      I like making things. I am still figuring out <em>which ones matter.</em>
    </h1>
    <p>
      That is the honest version. The rest is software, people, side projects, mistakes, and
      learning what happens after the code works.
    </p>
  </section>
  <section class="about-intro site-shell">
    <div class="about-photo" data-reveal>
      <Image
        src={portrait}
        alt="Qasim Sethar"
        width={900}
        height={1120}
        sizes="(max-width: 900px) 100vw, 42vw"
      />
      <span>QASIM SETHAR / 2026</span>
    </div>
    <div class="about-copy" data-reveal>
      <span class="eyebrow">THE SHORT VERSION</span>
      <h2>
        I like writing software. I am getting more interested in what happens <em>around it.</em>
      </h2>
      <p>
        I am a Computer Science student at Sukkur IBA University. Most of my spare time goes into
        building something, maintaining something I already shipped, or getting distracted by a
        problem that looked small five minutes earlier.
      </p>
      <p>
        I care about choosing a problem worth touching, doing the engineering properly, and putting
        it in front of someone who can tell me whether I was right.
      </p>
      <div class="about-actions">
        <a class="button-secondary" href="/resume.pdf">
          Résumé ↗
        </a>
        <a class="button-secondary" href="/contact/">
          Contact ↗
        </a>
      </div>
    </div>
  </section>
  <section class="section-block site-shell">
    <SectionHeading
      index="01"
      title="How I got here"
      note="Not a biography. Just the useful bits."
    />
    <div class="timeline">
      {timeline.map((item) => (
        <div class="timeline-row" data-reveal>
          <span>{item.period}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="section-block site-shell">
    <SectionHeading index="02" title="People and community" note="The work around the work." />
    <div class="people-grid">
      {people.map((item) => (
        <article class="people-card" data-reveal>
          <strong>{item.metric}</strong>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section-block site-shell">
    <SectionHeading index="03" title="Professional work" />
    <div class="professional-list">
      {professional.map((item) => (
        <div class="professional-row" data-reveal>
          <span>{item.company}</span>
          <div>
            <strong>{item.role}</strong>
            <p>{item.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="section-block site-shell">
    <SectionHeading
      index="04"
      title="How I work"
      note="The boring details that are actually mine."
    />
    <div class="workstyle-grid">
      <div class="workstyle-copy" data-reveal>
        <span class="eyebrow">A FEW TELLS</span>
        <h2>
          The tools are ordinary.
          <br />
          <em>I just use them a lot.</em>
        </h2>
        <p>
          I have been on Arch Linux for roughly two years. I know a stupid number of keyboard
          shortcuts, write small scripts when something gets repetitive, and use Vim inside VS Code.
          I use Vim inside VS Code. The mouse still exists. I just do not reach for it first.
        </p>
      </div>
      <div class="workstyle-table">
        {workStyle.map((item) => (
          <div>
            <span>{item.key}</span>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section-block site-shell">
    <SectionHeading index="05" title="Programs and recognition" />
    <div class="recognition-list">
      {recognition.map((item) => (
        <div class="recognition-row" data-reveal>
          <span>PROGRAM</span>
          <strong>{item.label}</strong>
          <p>{item.detail}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="section-block site-shell">
    <SectionHeading
      index="06"
      title="Elsewhere"
      note="Primary links first. The rest is there if you go looking."
    />
    <div class="elsewhere-grid">
      <div>
        <span class="eyebrow">PRIMARY</span>
        {site.social.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label}
            <b>↗</b>
          </a>
        ))}
      </div>
      <div>
        <span class="eyebrow">MORE INTERNET</span>
        {site.secondary.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label}
            <b>↗</b>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="about-end site-shell" data-reveal>
    <span class="eyebrow">07 / CURRENT</span>
    <h2>
      Building deeper systems.
      <br />
      <em>Learning how to reach people.</em>
    </h2>
    <p>The second part is the one I am still learning.</p>
  </section>
</Base>
