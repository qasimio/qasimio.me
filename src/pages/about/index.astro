---
import Shell from '../../layouts/Shell.astro';
import { site, recognition, professional } from '../../data/site';
import qasim from '../../assets/identity/qasim.jpg';
---

<Shell current="about" title="About — Qasim Sethar">
  <section class="page-section" style="padding-top:18px">
    <span class="eyebrow">ABOUT</span>
    <h1 style="margin:14px 0 0;color:var(--white);font-size:clamp(52px,6.8vw,90px);line-height:.98;letter-spacing:-.06em;font-weight:700">
      More than the code.
    </h1>
  </section>
  <section class="page-section">
    <div class="about-grid">
      <div>
        <div class="about-photo-wrap">
          <img class="about-photo" src={qasim.src} alt="Qasim Sethar" />
        </div>
        <div class="about-callout">
          “I want to own the problem from the first annoying thought to the thing somebody keeps
          using.”
        </div>
      </div>
      <div class="copy-stack">
        <p>
          I'm Qasim, a software engineer and CS student at <strong>{site.university}</strong>. I
          spend most of my time building software and a smaller but important amount of time helping
          other people build theirs.
        </p>
        <p>
          My projects move between AI systems, retrieval, search, developer tools, automation, and
          small products for very specific problems.
        </p>
        <p>
          I also care about the non-code side: organizing events, reviewing student projects,
          building communities, talking to users, maintaining open source, and learning how to get
          something in front of people instead of keeping it in a repository forever.
        </p>
        <p>
          I use Arch Linux as my daily development environment, work inside VS Code with Vim, and
          prefer keyboard-first workflows. Mostly because I am stubborn. Partly because it is fast.
        </p>
      </div>
    </div>
  </section>
  <section class="page-section">
    <div class="section-head">
      <span class="section-num">01</span>
      <span class="section-title">Recognition & programs</span>
    </div>
    <div class="experience">
      {recognition.map((item, index) => (
        <article class="experience-row">
          <div class="experience-time">0{index + 1}</div>
          <div>
            <div class="experience-place">{item[0]}</div>
            <p class="experience-copy">{item[1]}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="page-section">
    <div class="section-head">
      <span class="section-num">02</span>
      <span class="section-title">Professional work</span>
    </div>
    <div class="experience">
      {professional.map((item, index) => (
        <article class="experience-row">
          <div class="experience-time">0{index + 1}</div>
          <div>
            <div class="experience-place">{item[0]}</div>
            <div class="experience-role">{item[1]}</div>
            <p class="experience-copy">{item[2]}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="page-section">
    <div class="section-head">
      <span class="section-num">03</span>
      <span class="section-title">Elsewhere</span>
    </div>
    <div class="now-grid" style="grid-template-columns:repeat(2,1fr)">
      {site.socials.map((item) => (
        <a class="now-item" href={item.url} target="_blank" rel="noreferrer">
          <small>{item.short}</small>
          <strong>{item.label} ↗</strong>
        </a>
      ))}
    </div>
  </section>
</Shell>
