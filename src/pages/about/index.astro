---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactForm from '../../components/ContactForm.astro';
import { milestones, site } from '../../data/site';
import portrait from '../../assets/identity/qasim-portrait.jpg';
---
<Base title="About — Qasim Sethar">
  <PageIntro
    eyebrow="About"
    title={'A person who keeps <em>building.</em>'}
    body="I am Qasim Sethar. I like software, difficult problems, independent work, and the point where something I built becomes useful to another person."
  />

  <section class="site-shell about-layout">
    <div class="about-portrait" data-reveal>
      <Image src={portrait} alt="Qasim Sethar" widths={[400]} sizes="(max-width: 960px) 100vw, 50vw" />
      <div class="about-portrait__copy">
        <p class="eyebrow">The short version</p>
        <h2>I would rather <em>make</em> something than wait for permission.</h2>
        <p>I build products and systems, but I also care about the things around them: people, communities, distribution, writing, and what happens after the code leaves the screen.</p>
        <p>I am studying Computer Science at Sukkur IBA University while working across AI systems, backend engineering, open source, and whatever problem I am currently unable to ignore.</p>
      </div>
    </div>

    <div style="padding-top: 8rem;">
      <div class="section-heading" data-reveal>
        <div class="section-heading__title"><span class="section-index">01</span><h2>Things that happened</h2></div>
      </div>
      <div class="milestones">
        {milestones.map((milestone) => (
          <div class="milestone" data-reveal>
            <span class="milestone__label">{milestone.label}</span>
            <span class="milestone__title">{milestone.title}</span>
            <span class="milestone__detail">{milestone.detail}</span>
          </div>
        ))}
      </div>
    </div>

    <div style="padding-top: 8rem;">
      <div class="section-heading" data-reveal>
        <div class="section-heading__title"><span class="section-index">02</span><h2>Beyond code</h2></div>
      </div>
      <div class="about-columns">
        <div class="about-column">
          <h3>People</h3>
          <p>Executive member of the CS Society at SIBA. Helped organize Sibathon ’26, a 24-hour student hackathon, reviewed 60+ projects, and guided 35+ students and peers.</p>
        </div>
        <div class="about-column">
          <h3>Communities</h3>
          <p>Creator and maintainer of the SIBA Launchpad ecosystem and the FOLDR organization on GitHub.</p>
        </div>
        <div class="about-column">
          <h3>Open source</h3>
          <p>Maintainer and contributor across public projects, with FOLDR as the clearest example of something that escaped the repository and found real users.</p>
        </div>
        <div class="about-column">
          <h3>Developer life</h3>
          <p>Arch Linux is my daily environment. I work keyboard-first, live in shortcuts, and use Vim inside VS Code because apparently one editor was insufficient.</p>
        </div>
      </div>
    </div>

    <div style="padding-top: 8rem;">
      <div class="section-heading" data-reveal>
        <div class="section-heading__title"><span class="section-index">03</span><h2>Professional work</h2></div>
      </div>
      <div class="about-columns">
        <div class="about-column">
          <h3>FlyRank</h3>
          <p>Backend AI engineering work across production-oriented software and AI systems.</p>
        </div>
        <div class="about-column">
          <h3>Arch Technologies</h3>
          <p>Machine learning engineering work involving model fine-tuning, NLP workflows, and local inference.</p>
        </div>
        <div class="about-column">
          <h3>Programs</h3>
          <p>GitHub Developer Program and GitHub Maintainer Community participation, alongside ongoing open-source work.</p>
        </div>
        <div class="about-column">
          <h3>Certification</h3>
          <p>Google AI Professional Certificate.</p>
        </div>
      </div>
    </div>

    <div style="padding-top: 8rem;">
      <div class="section-heading" data-reveal>
        <div class="section-heading__title"><span class="section-index">04</span><h2>Elsewhere</h2></div>
      </div>
      <div class="about-columns">
        <div class="about-column">
          <h3>Primary</h3>
          {site.socials.map((item) => <p><a href={item.href} target="_blank" rel="noreferrer">{item.label} ↗</a></p>)}
        </div>
        <div class="about-column">
          <h3>More</h3>
          {site.elsewhere.map((item) => <p><a href={item.href} target="_blank" rel="noreferrer">{item.label} ↗</a></p>)}
        </div>
      </div>
    </div>

    <div style="padding-top: 8rem;" id="contact">
      <div class="contact-block" data-reveal>
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Something <em>interesting?</em></h2>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
