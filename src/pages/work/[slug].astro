---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';

type Project = CollectionEntry<'projects'>;

export async function getStaticPaths() {
  const projects = await getCollection<'projects'>('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Project };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="project-page site-shell">
    <header class="project-hero" data-reveal>
      <div class="project-hero__meta">
        <span>{String(entry.data.year)}</span>
        <span>{entry.data.type.replace('-', ' ')}</span>
        <span>{entry.data.status}</span>
      </div>
      <h1 transition:name={`project-${entry.id}`}>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <div class="project-links">
        {entry.data.links.map((link) => (
          <a href={link.url} target="_blank" rel="noreferrer">
            {link.label}
            <span>↗</span>
          </a>
        ))}
      </div>
    </header>

    <section class="project-showcase" data-reveal>
      <ProjectVisual slug={entry.id} />
      {entry.data.stats.length > 0 && (
        <div class="project-stats">
          {entry.data.stats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      )}
    </section>

    <div class="project-content-wrap">
      <div class="prose">
        <Content />
      </div>
      <aside class="project-aside">
        <div>
          <span>ROLE</span>
          <strong>{entry.data.role}</strong>
        </div>
        <div>
          <span>TOPICS</span>
          <strong>{entry.data.tags.join(' · ')}</strong>
        </div>
        {entry.data.pullQuote && <blockquote>“{entry.data.pullQuote}”</blockquote>}
      </aside>
    </div>
  </article>
</Base>
