---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import portrait from '../../assets/identity/qasim-portrait.jpg';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const related = (await getCollection('projects'))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base title={`${entry.data.title} — Qasim Sethar`} description={entry.data.summary}>
  <article class="case-study site-shell">
    <div class="case-top">
      <a class="back-link" href="/work/">
        ← Work
      </a>
      <span>
        {entry.data.year} / {entry.data.type.replace('-', ' ')}
      </span>
      <span>{entry.data.status}</span>
    </div>
    <header class="case-hero" data-reveal>
      <div class="case-copy">
        <span class="eyebrow">{entry.data.role}</span>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
        <div class="case-links">
          {entry.data.links.map((link) => (
            <a class="text-link" href={link.url} target="_blank" rel="noreferrer">
              {link.label} <span>↗</span>
            </a>
          ))}
        </div>
      </div>
      <div class="case-visual">
        <ProjectVisual slug={entry.data.visual} mode="hero" />
      </div>
    </header>
    {entry.data.stats.length > 0 && (
      <div class="case-stats">
        {entry.data.stats.map((stat) => (
          <div>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    )}
    <div class="case-grid">
      <aside class="case-aside">
        <span>PROJECT</span>
        <strong>{entry.data.title}</strong>
        <span>ROLE</span>
        <strong>{entry.data.role}</strong>
        <span>YEAR</span>
        <strong>{entry.data.year}</strong>
        <span>TOOLS</span>
        <strong>{entry.data.tags.join(' · ')}</strong>
      </aside>
      <div class="case-content prose">
        <Content />
      </div>
    </div>
    <section class="case-end" data-reveal>
      <div class="case-end-photo">
        <Image src={portrait} alt="Qasim Sethar" width={650} height={800} />
      </div>
      <div>
        <span class="eyebrow">THE POINT</span>
        <h2>
          The interesting part begins when the code <em>leaves the demo.</em>
        </h2>
        <p>
          That is when constraints turn into product decisions, and nice architecture has to meet
          actual people.
        </p>
      </div>
    </section>
    <section class="related-work">
      <SectionHeading index="∞" title="Keep going" />
      <div class="related-grid">
        {related.map((item) => (
          <a href={`/work/${item.id}/`}>
            <span>{item.data.type}</span>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            <b>↗</b>
          </a>
        ))}
      </div>
    </section>
  </article>
</Base>
