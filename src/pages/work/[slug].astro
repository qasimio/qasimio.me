---
import Shell from '../../layouts/Shell.astro';
import { getCollection, render } from 'astro:content';
const projects = await getCollection('projects');
export function getStaticPaths() {
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Shell current="work" title={`${entry.data.title} — Qasim Sethar`}>
  <article class="page-section" style="padding-top:18px">
    <span class="eyebrow">{entry.data.eyebrow}</span>
    <h1 style="margin:14px 0 0;color:var(--white);font-size:clamp(54px,7vw,94px);line-height:.98;letter-spacing:-.06em;font-weight:700">
      {entry.data.title}
    </h1>
    <p class="hero-copy">{entry.data.summary}</p>
    <div class="project-links">
      {entry.data.links.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer">
          {link.label} ↗
        </a>
      ))}
    </div>
    {entry.data.stats.length > 0 && (
      <div class="proof-grid" style="margin-top:36px">
        {entry.data.stats.map((stat) => (
          <div class="proof-item">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    )}
    <div class="prose" style="margin-top:42px">
      <Content />
    </div>
  </article>
</Shell>
