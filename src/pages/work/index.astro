---
import Shell from '../../layouts/Shell.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const types = [...new Set(projects.map((p) => p.data.type))];
---

<Shell current="work" title="Experience + Work — Qasim Sethar">
  <section class="page-section" style="padding-top:18px">
    <span class="eyebrow">EXPERIENCE + WORK</span>
    <h1
      class="hero-title"
      style="margin:15px 0 0;color:var(--white);font-size:clamp(50px,6.2vw,82px);line-height:1.02;letter-spacing:-.055em;font-weight:700"
    >
      Things I actually built.
    </h1>
    <p class="hero-copy">
      Products, systems, open-source tools, and a few experiments that got far enough to leave a
      trail.
    </p>
  </section>
  <section class="page-section">
    <div class="section-head">
      <span class="section-num">01</span>
      <span class="section-title">Featured</span>
    </div>
    <div class="project-list">
      {projects
        .filter((p) => p.data.featured)
        .map((entry) => (
          <ProjectCard entry={entry} />
        ))}
    </div>
  </section>
  <section class="page-section">
    <div class="section-head">
      <span class="section-num">02</span>
      <span class="section-title">All work</span>
    </div>
    <div class="filter-row" data-project-filters>
      <button class="filter-btn" data-project-filter="all" aria-pressed="true">
        All
      </button>
      {types.map((type) => (
        <button class="filter-btn" data-project-filter={type} aria-pressed="false">
          {type}
        </button>
      ))}
    </div>
    <div class="project-list" id="project-archive">
      {projects.map((entry) => (
        <ProjectCard entry={entry} />
      ))}
    </div>
  </section>
</Shell>
<script is:inline>
  const initProjectFilters = () => {
    const root = document.querySelector('[data-project-filters]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    root.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-project-filter]');
      if (!btn) return;
      const value = btn.dataset.projectFilter;
      root
        .querySelectorAll('[data-project-filter]')
        .forEach((i) => i.setAttribute('aria-pressed', String(i === btn)));
      document.querySelectorAll('#project-archive .project-card').forEach((card) => {
        const meta = card.querySelector('.project-meta')?.textContent || '';
        const type = meta.split('·')[1]?.trim() || '';
        card.hidden = value !== 'all' && type !== value;
      });
    });
  };
  initProjectFilters();
  document.addEventListener('astro:page-load', initProjectFilters);
</script>
