---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const archive = projects.filter((p) => !p.data.featured);
const types = ['all', ...Array.from(new Set(projects.map((p) => p.data.type)))];
---

<Base
  title="Work — Qasim Sethar"
  description="Projects, systems, products, open source, and communities built by Qasim Sethar."
>
  <section class="page-hero site-shell work-page-hero">
    <div class="page-hero-meta">
      <span>01 / WORK</span>
      <span>{projects.length} things</span>
    </div>
    <h1>
      I build, then I find out what <em>survives.</em>
    </h1>
    <p>
      Some projects became products. Some became systems. Some taught me enough to build the next
      thing better. Here is the trail.
    </p>
  </section>
  <section class="section-block site-shell">
    <SectionHeading index="01" title="Featured" note="The work worth opening." />
    <div class="work-featured">
      {featured.map((entry) => (
        <ProjectCard entry={entry} featured />
      ))}
    </div>
  </section>
  <section class="section-block site-shell work-archive">
    <div class="filter-line">
      <div class="filters" data-project-filters>
        {types.map((type, i) => (
          <button
            type="button"
            class:list={['filter-chip', { active: i === 0 }]}
            data-filter={type}
          >
            {type.replace('-', ' ')}
          </button>
        ))}
      </div>
      <span class="filter-count" data-filter-count>
        {archive.length} more
      </span>
    </div>
    <div class="archive-list" data-project-list>
      {archive.map((entry) => (
        <a
          class="archive-item"
          href={`/work/${entry.id}/`}
          data-project-card
          data-type={entry.data.type}
        >
          <span>{entry.data.year}</span>
          <strong>{entry.data.title}</strong>
          <span>{entry.data.type.replace('-', ' ')}</span>
          <p>{entry.data.summary}</p>
          <b>↗</b>
        </a>
      ))}
    </div>
  </section>
  <script>
    const setupProjectFilters = () => {
      const root = document.querySelector('[data-project-filters]');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = 'true';
      const buttons = [...root.querySelectorAll('[data-filter]')];
      const cards = [...document.querySelectorAll('[data-project-list] [data-project-card]')];
      const count = document.querySelector('[data-filter-count]');
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          const value = button.dataset.filter;
          buttons.forEach((b) => b.classList.toggle('active', b === button));
          let visible = 0;
          cards.forEach((card) => {
            const show = value === 'all' || card.dataset.type === value;
            card.hidden = !show;
            if (show) visible++;
          });
          if (count) count.textContent = `${visible} shown`;
        }),
      );
    };
    document.addEventListener('astro:page-load', setupProjectFilters);
    setupProjectFilters();
  </script>
</Base>
