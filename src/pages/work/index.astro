---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((entry) => entry.data.featured);
const archive = projects.filter((entry) => !entry.data.featured);
const types = ['all', ...new Set(projects.map((entry) => entry.data.type))];
---

<Base
  title="Work — Qasim Sethar"
  description="Systems, products, tools, and community projects built by Qasim Sethar."
>
  <section class="shell page-hero">
    <div class="page-hero__top">
      <span>01 / WORK</span>
      <span>{projects.length} PROJECTS</span>
    </div>
    <p class="eyebrow eyebrow--teal">BUILT / SHIPPED / STILL STUBBORN</p>
    <h1>
      I make things that have to <em>work.</em>
    </h1>
    <p class="page-hero__lede">
      Some became products. Some became tools. Some started as a way to understand a problem
      properly. The useful thing is the trail they leave behind.
    </p>
  </section>
  <section class="shell section" style="padding-top:2rem">
    <div class="section-head">
      <div class="section-head__left">
        <span class="section-head__number">01</span>
        <h2>Flagship work</h2>
      </div>
      <div class="section-head__right">
        <span>the few worth lingering on</span>
      </div>
    </div>
    <div class="featured-layout">
      {featured.map((entry, i) => (
        <ProjectCard entry={entry} featured={i === 0} />
      ))}
    </div>
  </section>
  <section class="shell section" style="padding-top:2rem">
    <div class="section-head">
      <div class="section-head__left">
        <span class="section-head__number">02</span>
        <h2>Everything else</h2>
      </div>
      <div class="section-head__right">
        <span>{archive.length} more</span>
      </div>
    </div>
    <div class="filter-bar" role="group" aria-label="Filter projects">
      {types.map((type, i) => (
        <button type="button" data-project-filter={type} aria-pressed={i === 0}>
          {type.replace('-', ' ')}
        </button>
      ))}
    </div>
    <div class="featured-layout">
      {archive.map((entry) => (
        <div data-project-item data-project-type={entry.data.type}>
          <ProjectCard entry={entry} />
        </div>
      ))}
    </div>
  </section>
</Base>
