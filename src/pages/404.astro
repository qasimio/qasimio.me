---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Qasim Sethar" noIndex>
  <section class="shell page-hero">
    <div class="page-hero__top">
      <span>404</span>
      <span>NOT FOUND</span>
    </div>
    <p class="eyebrow eyebrow--coral">WRONG DOOR</p>
    <h1>
      That page isn't <em>here.</em>
    </h1>
    <p class="page-hero__lede">
      The link may be old, the route may have moved, or the internet has once again misplaced
      something.
    </p>
    <a class="button button--primary" href="/">
      Back home ↗
    </a>
  </section>
</Base>
