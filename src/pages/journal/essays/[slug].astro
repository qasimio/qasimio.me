---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} — Qasim Sethar`} description={entry.data.description}>
  <article class="note-page site-shell">
    <header class="note-page__hero" data-reveal>
      <p class="eyebrow">Essay</p>
      <h1>{entry.data.title}</h1>
      <p class="page-intro__body">{entry.data.description}</p>
    </header>
    <div class="note-page__body prose"><Content /></div>
  </article>
</Base>
