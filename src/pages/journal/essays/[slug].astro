---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'essays'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Qasim Sethar`} description={entry.data.description}>
  <article class="narrow page-hero">
    <div class="page-hero__top">
      <span>
        {entry.data.publishedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
      </span>
      <span>ESSAY</span>
    </div>
    <p class="eyebrow eyebrow--violet">LONGER VERSION</p>
    <h1>{entry.data.title}</h1>
    <p class="page-hero__lede">{entry.data.description}</p>
    <div class="prose" style="max-width:780px;margin-top:3rem">
      <Content />
    </div>
  </article>
</Base>
