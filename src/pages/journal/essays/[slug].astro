---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';

type Essay = CollectionEntry<'essays'>;

export async function getStaticPaths() {
  const essays = await getCollection<'essays'>('essays');
  return essays
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Essay };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="essay-page site-shell">
    <header class="note-page__head" data-reveal>
      <div>
        <span>essay</span>
        <time datetime={entry.data.publishedAt.toISOString()}>
          {entry.data.publishedAt.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </time>
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
    </header>
    <div class="note-page__body">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>
