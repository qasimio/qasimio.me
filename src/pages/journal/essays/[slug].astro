---
import Shell from '../../../layouts/Shell.astro';
import { getCollection, render } from 'astro:content';
const essays = await getCollection('essays', ({ data }) => !data.draft);
export function getStaticPaths() {
  return essays.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Shell current="journal" title={`${entry.data.title} — Qasim Sethar`}>
  <article class="page-section" style="padding-top:18px">
    <span class="eyebrow">
      ESSAY ·{' '}
      {entry.data.publishedAt.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </span>
    <h1 style="margin:14px 0 0;color:var(--white);font-size:clamp(48px,6.8vw,90px);line-height:.98;letter-spacing:-.06em;font-weight:700">
      {entry.data.title}
    </h1>
    <p class="hero-copy">{entry.data.description}</p>
    <div class="prose" style="margin-top:42px">
      <Content />
    </div>
  </article>
</Shell>
