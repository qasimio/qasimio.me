---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SideRails from '../../components/SideRails.astro';
import { notes } from '../../data/site';
export function getStaticPaths() {
  return notes
    .filter((note) => !note.external)
    .map((note) => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
---

<Layout title={`${note.title} — Qasim Sethar`} description={note.excerpt}>
  <Nav />
  <SideRails />
  <main id="content" class="site-content">
    <article class="section section--first note-page">
      <p class="overline">02. / JOURNAL / {note.kind}</p>
      <time class="note-page__date">{note.date}</time>
      <h1>{note.title}</h1>
      <p class="note-page__lead">{note.excerpt}</p>
      <div class="note-page__body">
        <p>{note.excerpt}</p>
        <p>
          Some notes stay short on purpose. The useful thing here is not pretending every thought
          deserves an essay. The point is to keep a record of what happened while it is still fresh
          enough to be honest.
        </p>
        <p>Tags: {note.tags.join(' · ')}</p>
      </div>
      <a class="archive-link" href="/journal/">
        ← Journal
      </a>
    </article>
  </main>
</Layout>
