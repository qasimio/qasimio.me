---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteRow from '../../components/NoteRow.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const types = ['all', ...new Set(notes.map((entry) => entry.data.type))];
const years = [...new Set(notes.map((entry) => entry.data.publishedAt.getFullYear()))];
---

<Base title="Journal — Qasim Sethar" description="Notes and longer writing from Qasim Sethar.">
  <section class="shell page-hero">
    <div class="page-hero__top">
      <span>02 / JOURNAL</span>
      <span>NOTES + ESSAYS</span>
    </div>
    <p class="eyebrow eyebrow--violet">A PUBLIC LOG</p>
    <h1>
      Things I don't want to <em>forget.</em>
    </h1>
    <p class="page-hero__lede">
      Short things from building, shipping, breaking, learning, and noticing something before the
      internet moves on.
    </p>
  </section>
  <section class="shell section" style="padding-top:2rem">
    <div class="section-head">
      <div class="section-head__left">
        <span class="section-head__number">01</span>
        <h2>Notes</h2>
      </div>
      <div class="section-head__right">
        <a href="/journal/rss.xml">RSS ↗</a>
      </div>
    </div>
    <div class="filter-bar">
      {types.map((type, i) => (
        <button type="button" data-note-filter={type} aria-pressed={i === 0}>
          {type.replace('-', ' ')}
        </button>
      ))}
    </div>
    {years.map((year) => (
      <div class="journal-year">
        <div class="journal-year__year">{year}</div>
        <div class="note-list" style="border-top:0">
          {notes
            .filter((entry) => entry.data.publishedAt.getFullYear() === year)
            .map((entry) => (
              <div data-note-item data-note-type={entry.data.type}>
                <NoteRow entry={entry} />
              </div>
            ))}
        </div>
      </div>
    ))}
  </section>
  <section class="shell section" style="padding-top:2rem">
    <div class="section-head">
      <div class="section-head__left">
        <span class="section-head__number">02</span>
        <h2>Essays</h2>
      </div>
      <div class="section-head__right">
        <span>{essays.length ? 'when the short version breaks' : 'nothing forced'}</span>
      </div>
    </div>
    {essays.length ? (
      <div class="essay-grid">
        {essays.map((entry) => (
          <a class="essay-card" href={`/journal/essays/${entry.id}/`}>
            <small>
              {entry.data.publishedAt.toLocaleDateString('en-US', {
                month: 'short',
                year: 'numeric',
              })}
            </small>
            <div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="narrow" style="padding:2rem 0;color:var(--muted)">
        I will write something long when the short version stops being enough.
      </div>
    )}
  </section>
</Base>
