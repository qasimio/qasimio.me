---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SideRails from '../../components/SideRails.astro';
import NoteRow from '../../components/NoteRow.astro';
import { notes } from '../../data/site';
---

<Layout
  title="Journal — Qasim Sethar"
  description="Short notes and longer writing by Qasim Sethar."
>
  <Nav />
  <SideRails />
  <main id="content" class="site-content">
    <section class="section section--first page-head">
      <p class="overline">02. / JOURNAL</p>
      <h1>Things I don’t want to forget.</h1>
      <p>
        Short notes from things I shipped, learned, broke, argued with, or could not stop thinking
        about.
      </p>
    </section>
    <section class="section section--tight">
      <h2 class="numbered-heading">Notes</h2>
      <ul class="notes-list">
        {notes.map((note) => (
          <NoteRow note={note} />
        ))}
      </ul>
    </section>
    <section class="section section--tight">
      <h2 class="numbered-heading">Longer writing</h2>
      <p class="journal-empty">
        No essays yet. I would rather leave the shelf empty than manufacture something to fill it.
      </p>
    </section>
  </main>
</Layout>
