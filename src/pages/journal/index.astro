---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteRow from '../../components/NoteRow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const types = ['all', ...Array.from(new Set(notes.map((entry) => entry.data.type)))];
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<Base
  title="Journal — Qasim Sethar"
  description="Notes, observations, build logs, and longer writing by Qasim Sethar."
>
  <section class="page-hero site-shell journal-hero">
    <div class="page-hero-meta">
      <span>02 / JOURNAL</span>
      <span>notes + essays</span>
    </div>
    <h1>
      Things I don't want to <em>lose.</em>
    </h1>
    <p>
      A public log for useful fragments: what shipped, what broke, what surprised me, and what I
      still cannot quite stop thinking about.
    </p>
  </section>
  <section class="section-block site-shell">
    <SectionHeading
      index="01"
      title="Notes"
      note={`${notes.length} entries`}
      href="/journal/rss.xml"
      linkLabel="RSS"
    />
    <div class="filters note-filters" data-note-filters>
      {types.map((type, i) => (
        <button
          class:list={['filter-chip', { active: i === 0 }]}
          data-note-filter={type}
          type="button"
        >
          {type}
        </button>
      ))}
    </div>
    <div class="notes-list" data-note-list>
      {notes.map((entry) => (
        <div data-note-item data-note-type={entry.data.type}>
          <NoteRow entry={entry} />
        </div>
      ))}
    </div>
  </section>
  <section class="journal-writing site-shell">
    <div class="writing-lead">
      <span class="eyebrow">LONGER WRITING</span>
      <h2>{essays.length ? 'A little more room.' : 'It will show up when it earns the length.'}</h2>
      <p>
        {essays.length
          ? 'Longer pieces for ideas that do not fit in a note.'
          : 'No filler. When an idea needs more than a few paragraphs, it can live here.'}
      </p>
    </div>
    {essays.length > 0 && (
      <div class="essay-list">
        {essays.map((entry) => (
          <a href={`/journal/essays/${entry.id}/`}>
            <span>
              {entry.data.publishedAt.toLocaleDateString('en-US', {
                month: 'short',
                year: 'numeric',
              })}
            </span>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <b>↗</b>
          </a>
        ))}
      </div>
    )}
  </section>
  <script>
    const setupNoteFilters = () => {
      const root = document.querySelector('[data-note-filters]');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = 'true';
      const buttons = [...root.querySelectorAll('[data-note-filter]')];
      const items = [...document.querySelectorAll('[data-note-list] [data-note-item]')];
      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          const value = button.dataset.noteFilter;
          buttons.forEach((b) => b.classList.toggle('active', b === button));
          items.forEach(
            (item) => (item.hidden = !(value === 'all' || item.dataset.noteType === value)),
          );
        }),
      );
    };
    document.addEventListener('astro:page-load', setupNoteFilters);
    setupNoteFilters();
  </script>
</Base>
