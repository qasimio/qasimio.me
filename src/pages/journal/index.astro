---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import SideRails from '../../components/SideRails.astro';
import NoteRow from '../../components/NoteRow.astro';
import { notes } from '../../data/site';
---

<Layout
  title="Journal — Qasim Sethar"
  description="Short notes and longer writing by Qasim Sethar."
>
  <Nav />
  <SideRails />
  <main id="content" class="site-content">
    <section class="section" style="padding-top: 180px;">
      <p class="overline">Public notes</p>
      <h1 class="hero__name" style="font-size: clamp(52px, 8vw, 82px);">
        Things I wanted to keep.
      </h1>
      <p style="max-width:700px; margin-top:25px; font-size:20px;">
        Short notes from things I shipped, learned, broke, argued with, or could not stop thinking
        about. Long-form writing shows up when an idea earns the extra length.
      </p>
    </section>
    <section class="section section--tight">
      <h2 class="numbered-heading">Notes</h2>
      <ul class="notes-list">
        {notes.map((note) => (
          <NoteRow note={note} />
        ))}
      </ul>
    </section>
    <section class="section section--tight">
      <h2 class="numbered-heading">Essays</h2>
      <p style="max-width:700px;">
        No filler. Long-form writing appears when the idea survives a second reading.
      </p>
    </section>
  </main>
</Layout>
