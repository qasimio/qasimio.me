---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';

type Note = CollectionEntry<'notes'>;

export async function getStaticPaths() {
  const notes = await getCollection<'notes'>('notes');
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Note };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.title}>
  <article class="note-page site-shell">
    <header class="note-page__head" data-reveal>
      <div>
        <span>{entry.data.type}</span>
        <time datetime={entry.data.publishedAt.toISOString()}>
          {entry.data.publishedAt.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </time>
      </div>
      <h1>{entry.data.title}</h1>
      <div class="note-page__tags">
        {entry.data.tags.map((tag: string) => (
          <span>#{tag}</span>
        ))}
      </div>
    </header>
    <div class="note-page__body">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>
