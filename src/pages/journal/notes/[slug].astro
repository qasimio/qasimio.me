---
import Shell from '../../../layouts/Shell.astro';
import { getCollection, render } from 'astro:content';
const notes = await getCollection('notes', ({ data }) => !data.draft);
export function getStaticPaths() {
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Shell current="journal" title={`${entry.data.title} — Qasim Sethar`}>
  <article class="page-section" style="padding-top:18px">
    <span class="eyebrow">
      {entry.data.type} ·{' '}
      {entry.data.publishedAt.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </span>
    <h1 style="margin:14px 0 0;color:var(--white);font-size:clamp(44px,6.2vw,78px);line-height:1.04;letter-spacing:-.055em;font-weight:700">
      {entry.data.title}
    </h1>
    <div class="tags">
      {entry.data.tags.map((tag) => (
        <span class="tag">#{tag}</span>
      ))}
    </div>
    <div class="prose" style="margin-top:38px">
      <Content />
    </div>
  </article>
</Shell>
