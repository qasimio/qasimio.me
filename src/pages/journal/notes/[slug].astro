---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'notes'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Journal`} description={entry.data.excerpt}>
  <article class="narrow page-hero">
    <div class="page-hero__top">
      <span>
        {entry.data.publishedAt.toLocaleDateString('en-US', {
          month: 'short',
          day: '2-digit',
          year: 'numeric',
        })}
      </span>
      <span>{entry.data.type}</span>
    </div>
    <p class="eyebrow eyebrow--violet">NOTE</p>
    <h1 style="font-size:clamp(3.5rem,7vw,7rem)">{entry.data.title}</h1>
    <div class="prose" style="max-width:760px">
      <Content />
    </div>
    <div class="case-actions">
      <a class="button button--quiet" href="/journal/">
        Back to journal ↗
      </a>
    </div>
  </article>
</Base>
