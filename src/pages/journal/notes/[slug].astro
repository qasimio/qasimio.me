---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'notes'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Journal`} description={entry.data.excerpt}>
  <article class="note-page site-shell">
    <div class="note-top">
      <a class="back-link" href="/journal/">
        ← Journal
      </a>
      <time datetime={entry.data.publishedAt.toISOString()}>
        {entry.data.publishedAt.toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
        })}
      </time>
    </div>
    <header class="note-head">
      <span class="eyebrow">{entry.data.type}</span>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.excerpt}</p>
      <div class="note-tags">
        {entry.data.tags.map((tag) => (
          <span>#{tag}</span>
        ))}
      </div>
    </header>
    <div class="note-body prose">
      <Content />
    </div>
    <div class="note-end">
      <a href="/journal/">← Back to notes</a>
      <a href="/contact/">Talk ↗</a>
    </div>
  </article>
</Base>
