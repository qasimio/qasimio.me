---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.publishedAt
  ? entry.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : 'Recent';
---
<Base title={`${entry.data.title} — Qasim Sethar`}>
  <article class="note-page site-shell">
    <header class="note-page__hero" data-reveal>
      <p class="eyebrow">{entry.data.type}</p>
      <h1>{entry.data.title}</h1>
      <div class="note-page__meta"><span>{date}</span>{entry.data.tags.map((tag) => <span>#{tag}</span>)}</div>
    </header>
    <div class="note-page__body prose"><Content /></div>
  </article>
</Base>
