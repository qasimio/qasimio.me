---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SideRails from '../components/SideRails.astro';
import Loader from '../components/Loader.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import Icons from '../components/Icons.astro';
import {
  featuredProjects,
  otherProjects,
  notes,
  experience,
  timeline,
  site,
  skills,
} from '../data/site';
---

<Layout
  title="Qasim Sethar — Software Engineer"
  description="Qasim Sethar builds software, systems, and products."
  home
>
  <Loader />
  <Nav />
  <SideRails />

  <main id="content" class="site-content">
    <section class="section hero" id="hero">
      <div class="hero__content">
        <p class="hero__intro reveal">Hi, my name is</p>
        <h1 class="hero__name reveal">Qasim Sethar.</h1>
        <h2 class="hero__role reveal">I build things for the web.</h2>
        <h3 class="hero__subrole reveal">And systems around them.</h3>
        <p class="hero__description reveal">
          I’m a computer science student and software engineer who likes building useful systems,
          shipping them, and learning what changes when someone else actually uses them.
        </p>
        <a class="big-button hero__button reveal" href="#about">
          Get to know me ↘
        </a>
      </div>
    </section>

    <section class="section reveal" id="about">
      <h2 class="numbered-heading">About Me</h2>
      <div class="about__grid">
        <div class="about__text">
          <p>
            Hello! I’m Qasim. I spend a lot of my time making software and an almost equal amount of
            time figuring out why the software I just made is behaving strangely.
          </p>
          <p>
            I started with projects because I wanted to understand how things worked. That turned
            into search, retrieval, AI systems, developer tools, and the more annoying question of
            what happens after the code leaves the editor.
          </p>
          <p>
            I care about the whole loop: finding a problem, building the thing, making it reliable,
            putting it somewhere people can use, and listening when reality disagrees with the plan.
          </p>
          <p>Some of the things I work with:</p>
          <ul class="about__skills">
            {skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </div>
        <div class="about__photo reveal">
          <div class="about__photo-wrap">
            <img
              src="/identity/qasim.jpg"
              alt="Portrait of Qasim Sethar"
              width="500"
              height="500"
              loading="lazy"
            />
          </div>
          <p class="about__caption">Qasim / qasimio · Sukkur, Pakistan</p>
        </div>
      </div>
    </section>

    <section class="section jobs reveal" id="jobs" data-jobs>
      <h2 class="numbered-heading">Where I’ve Worked</h2>
      <div class="jobs__inner">
        <div class="jobs__tabs" role="tablist" aria-label="Experience tabs">
          {experience.map((job, index) => (
            <button
              class:list={['jobs__tab', { 'is-active': index === 0 }]}
              type="button"
              role="tab"
              data-job-tab
              aria-selected={index === 0}
              id={`job-tab-${index}`}
              aria-controls={`job-panel-${index}`}
              tabindex={index === 0 ? 0 : -1}
            >
              {job.company}
            </button>
          ))}
          <span class="jobs__indicator" data-job-indicator aria-hidden="true"></span>
        </div>
        <div class="jobs__panel">
          {experience.map((job, index) => (
            <div
              data-job-panel
              id={`job-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`job-tab-${index}`}
              hidden={index !== 0}
            >
              <h3 class="jobs__title">
                {job.title}
                {job.url ? (
                  <span class="jobs__company">
                    {' '}
                    @{' '}
                    <a class="inline-link" href={job.url} target="_blank" rel="noopener noreferrer">
                      {job.company}
                    </a>
                  </span>
                ) : (
                  <span class="jobs__company"> @ {job.company}</span>
                )}
              </h3>
              <p class="jobs__range">{job.range}</p>
              <ul>
                {job.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section reveal" id="timeline">
      <h2 class="numbered-heading">A trail of things happening</h2>
      <p class="timeline__intro">
        The résumé version is neat. This version is closer to how building actually happens: a line
        of projects, people, small bets, and things that changed the next thing I made.
      </p>
      <div class="timeline__track">
        {timeline.map((item) => (
          <article class="timeline__item">
            <span class="timeline__date">{item.date}</span>
            <h3 class="timeline__title">{item.title}</h3>
            <p class="timeline__meta">{item.meta}</p>
            <p class="timeline__body">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section reveal" id="projects">
      <h2 class="numbered-heading">Some Things I’ve Built</h2>
      <ul class="featured__grid">
        {featuredProjects.map((project, index) => (
          <FeaturedProject project={project} index={index} />
        ))}
      </ul>
    </section>

    <section class="section reveal" id="other-projects">
      <h2 class="numbered-heading">Other Noteworthy Projects</h2>
      <a class="archive-link" href="/archive/">
        view the archive ↗
      </a>
      <ul class="projects-grid">
        {otherProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </ul>
    </section>

    <section class="section reveal" id="writing">
      <h2 class="numbered-heading">Some writing</h2>
      <ul class="notes-list">
        {notes.slice(0, 4).map((note) => (
          <NoteRow note={note} />
        ))}
      </ul>
      <a class="archive-link" href="/journal/">
        view the journal ↗
      </a>
    </section>

    <section class="section contact reveal" id="contact">
      <p class="overline">04. What’s Next?</p>
      <h2 class="contact__title">Get In Touch</h2>
      <p class="contact__copy">
        Have a hard problem, a strange idea, or something you want to build? Send me the useful
        part.
      </p>
      <a class="big-button contact__email" href={`mailto:${site.email}`}>
        Say Hello ↗
      </a>
      <form class="contact__form" data-contact-form>
        <input
          class="contact__input"
          type="text"
          name="name"
          placeholder="Your name"
          autocomplete="name"
          required
        />
        <input
          class="contact__input"
          type="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <textarea
          class="contact__input"
          name="message"
          rows="5"
          placeholder="What are you building?"
          required
        ></textarea>
        <button class="big-button" type="submit">
          Compose email ↗
        </button>
        <p class="contact__form-note">No contact database. The form opens your email client.</p>
      </form>
    </section>
  </main>
</Layout>
