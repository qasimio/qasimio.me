---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import NoteRow from '../components/NoteRow.astro';
import { current, evidence, site } from '../data/site';
import portrait from '../assets/identity/qasim-portrait.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((entry) => entry.data.featured).slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---
<Base title={site.name} description={site.description}>
  <section class="home-hero site-shell">
    <div class="home-hero__topline">
      <span>QASIM SETHAR / QASIMIO</span>
      <span>SOFTWARE · PRODUCTS · ETC.</span>
    </div>
    <div class="home-hero__main">
      <h1>Things<br /><em>worth building.</em></h1>
      <div class="home-hero__aside" data-reveal>
        <p>I build software around problems that refuse to stay theoretical.</p>
        <a href="/work/">Enter the work <span>↗</span></a>
      </div>
    </div>
    <div class="home-hero__bottom">
      <span>SCROLL TO SEE WHAT MADE IT OUT</span>
      <span>↓</span>
    </div>
  </section>

  <section class="home-statement site-shell">
    <div class="statement-index">00</div>
    <div class="statement-copy" data-reveal>
      <p class="eyebrow">The idea</p>
      <h2>I am more interested in the <em>thing after the demo.</em></h2>
      <p>I like the part where a project gets installed, relied on, criticized, improved, passed to somebody else, and slowly stops being mine.</p>
    </div>
  </section>

  <section class="home-section site-shell">
    <SectionLabel index="01" title="Right now" href="/work/" linkLabel="See the work" />
    <div class="current-list">
      {current.map((item) => (
        <a class="current-item" href={item.href ?? '/about/'} target={item.href?.startsWith('http') ? '_blank' : undefined} rel={item.href?.startsWith('http') ? 'noreferrer' : undefined} data-reveal>
          <span class="current-number">{item.number}</span>
          <span class="current-label">{item.label}</span>
          <span class="current-title">{item.title}</span>
          <span class="current-detail">{item.detail}</span>
          <span class="current-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="evidence-band">
    <div class="site-shell evidence-grid">
      {evidence.map((item) => (
        <div class="evidence-item" data-reveal>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="home-section site-shell">
    <SectionLabel index="02" title="Work" href="/work/" linkLabel="All work" />
    <div class="featured-work">
      {featured.map((entry, index) => (
        <a class:list={['featured-project', `featured-project--${index + 1}`]} href={`/work/${entry.id}/`} data-reveal>
          <div class="featured-project__art"><ProjectVisual slug={entry.id} title={entry.data.title} /></div>
          <div class="featured-project__caption">
            <span>0{index + 1}</span>
            <span>{entry.data.title}</span>
            <span>{entry.data.summary}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section home-section--notes site-shell">
    <SectionLabel index="03" title="Journal" href="/journal/" linkLabel="Open journal" />
    <div class="notes-home">
      {notes.map((entry, index) => <NoteRow entry={entry} featured={index === 0} />)}
    </div>
  </section>

  <section class="home-section site-shell home-person">
    <div class="person-intro" data-reveal>
      <span class="section-index">04 / THE PERSON</span>
      <h2>Not only code.</h2>
      <p>There is the software. Then there is the part around it: organizing people, running events, reviewing work, learning to communicate, and trying to build things that survive contact with real users.</p>
      <a class="text-link" href="/about/">Meet the person <span>↗</span></a>
    </div>
    <div class="person-photo" data-reveal>
      <Image src={portrait} alt="Qasim Sethar" widths={[700]} sizes="(max-width: 900px) 100vw, 42vw" loading="lazy" />
      <div class="person-photo__tag">QASIM / 2026</div>
    </div>
  </section>

  <section class="home-end site-shell" data-reveal>
    <span class="eyebrow">05 / NEXT</span>
    <h2>Keep building.<br /><em>Keep publishing.</em></h2>
    <p>Short notes, longer thoughts, shipped work, and the occasional thing that should not have worked but somehow did.</p>
    <div class="home-end__links">
      <a href="/journal/">Journal <span>↗</span></a>
      <a href="/contact/">Contact <span>↗</span></a>
    </div>
  </section>
</Base>
