---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import portrait from '../assets/identity/qasim-portrait.jpg';
import { now, proof, principles } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((entry) => entry.data.featured).slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<Base
  title="Qasim Sethar — qasimio"
  description="Qasim Sethar builds software, products, tools, and communities around problems worth fixing."
>
  <section class="shell home-hero">
    <div class="hero-kicker eyebrow">
      <span>QASIM SETHAR / QASIMIO</span>
      <span>SOFTWARE · PRODUCTS · SYSTEMS</span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow eyebrow--teal">BUILD / SHIP / LEARN</p>
        <h1>
          I make software, then I make it <span class="accent">useful.</span>
        </h1>
        <p class="hero-lede">
          I build systems, tools, and products around problems that are annoying enough to deserve a
          proper fix. Some stay experiments. Some escape into the real world.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="/work/">
            See the work ↗
          </a>
          <a class="button button--quiet" href="/about/">
            About me ↗
          </a>
        </div>
      </div>
      <div class="hero-right" data-reveal>
        <div class="hero-portrait">
          <Image
            src={portrait}
            alt="Qasim Sethar"
            widths={[680, 960]}
            sizes="(max-width: 1050px) 100vw, 40vw"
          />
          <div class="hero-portrait__overlay">
            <span class="hero-portrait__tag">SUKKUR · PAKISTAN · 2026</span>
            <span class="hero-portrait__signal">Q</span>
          </div>
        </div>
        <article class="current-card">
          <div class="current-card__top">
            <span>RIGHT NOW</span>
            <span>01 / 03</span>
          </div>
          <h2>Still building. Still changing my mind about what is worth keeping.</h2>
          <p>Engram · Operon · SIBA Launchpad</p>
          <div class="current-card__stack">
            <span class="pill">open source</span>
            <span class="pill">product</span>
            <span class="pill">community</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="proof-band">
    <div class="shell proof-grid">
      {proof.map((item) => (
        <article class="proof-item" data-reveal>
          {item.href ? (
            <a href={item.href} target="_blank" rel="noreferrer">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
              <small>{item.note}</small>
            </a>
          ) : (
            <>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
              <small>{item.note}</small>
            </>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="shell section">
    <SectionHeading number="01" title="Currently" note="where my attention is going" />
    <div class="timeline">
      {now.map((item, i) => (
        <a class="timeline-row" data-reveal href={item.href}>
          <span class="timeline-row__year">
            0{i + 1} / {item.state}
          </span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="shell section">
    <SectionHeading
      number="02"
      title="Selected work"
      note="projects that explain the pattern"
      href="/work/"
      label="All work"
    />
    <div class="work-lead">
      <div>
        <p class="eyebrow eyebrow--teal">NOT A GALLERY</p>
        <h2>
          Things that made it out of my <em>head.</em>
        </h2>
      </div>
      <p>
        There is a difference between making something and making something somebody else can rely
        on. These are the things I care about enough to show properly.
      </p>
    </div>
    <div class="featured-layout">
      {featured.map((entry, i) => (
        <ProjectCard entry={entry} featured={i === 0} />
      ))}
    </div>
  </section>

  <section class="section" style="background: var(--surface); border-block:1px solid var(--line)">
    <div class="shell">
      <SectionHeading number="03" title="The small stuff matters" note="a tiny playground" />
      <div class="lab-layout">
        <div class="lab-intro" data-reveal>
          <p class="eyebrow eyebrow--violet">INTERACTION / FEEL</p>
          <h2>
            I like interfaces that <em class="display-serif">respond.</em>
          </h2>
          <p>
            Not because everything needs animation. Because a good interface tells you what
            happened, what can happen next, and when it is safe to trust it.
          </p>
        </div>
        <div class="lab-grid">
          <article class="lab-card" data-lab-card data-reveal>
            <div class="lab-card__top">
              <span>01</span>
              <span>KEYBOARD</span>
            </div>
            <h3>Open things without hunting.</h3>
            <p>The site has a command palette. Try Ctrl K, then use the arrow keys.</p>
            <div class="lab-demo">
              <div class="demo-keys">
                <span class="demo-key">Ctrl</span>
                <span class="demo-key">K</span>
                <span class="demo-key">↵</span>
              </div>
            </div>
          </article>
          <article class="lab-card" data-lab-card data-reveal>
            <div class="lab-card__top">
              <span>02</span>
              <span>REVERSIBLE</span>
            </div>
            <h3>Preview before you commit.</h3>
            <p>A tiny reminder of how I like automation to behave.</p>
            <div class="lab-demo">
              <div class="demo-reversible">
                <div class="demo-file">
                  files/<b data-lab-output>UNDO READY</b>
                </div>
                <button
                  class="demo-switch"
                  type="button"
                  aria-label="Toggle preview state"
                  aria-pressed="true"
                  data-lab-toggle
                >
                  <i></i>
                </button>
              </div>
            </div>
          </article>
          <article class="lab-card" data-lab-card data-reveal>
            <div class="lab-card__top">
              <span>03</span>
              <span>MOTION</span>
            </div>
            <h3>Make movement earn its keep.</h3>
            <p>Hover the things that are interactive. Quiet motion is still feedback.</p>
            <div class="lab-demo">
              <div style="height:8px;background:linear-gradient(90deg,var(--teal),var(--violet));border-radius:999px;transform-origin:0 50%;animation:lab-pulse 2.5s ease-in-out infinite"></div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="shell section">
    <SectionHeading number="04" title="How I build" note="three rules I keep relearning" />
    <div class="split-heading">
      <div>
        <p class="eyebrow eyebrow--coral">THE PATTERN</p>
      </div>
      <div>
        <h2>
          Useful beats impressive. <em>Especially after the demo ends.</em>
        </h2>
      </div>
    </div>
    <div class="stats-grid" style="margin-top:2rem">
      {principles.map((item, i) => (
        <article class="big-stat" data-reveal>
          <strong>0{i + 1}</strong>
          <span>{item.title}</span>
          <small>{item.detail}</small>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section">
    <SectionHeading
      number="05"
      title="Journal"
      note="short things worth keeping"
      href="/journal/"
      label="Open journal"
    />
    <div class="note-list">
      {notes.map((entry) => (
        <NoteRow entry={entry} />
      ))}
    </div>
  </section>

  <section class="section" style="background:var(--bg-soft)">
    <div class="shell split-heading">
      <div data-reveal>
        <p class="eyebrow eyebrow--coral">06 / THE OTHER HALF</p>
      </div>
      <div data-reveal>
        <h2>
          I build around people too.{' '}
          <em class="display-serif">Launchpad, Sibathon, reviews, mentoring.</em>
        </h2>
        <p style="color:var(--muted);max-width:58ch">
          The interface is usually the easy part. Getting someone to publish unfinished work, ask a
          better question, or keep going when the project is messy is harder.
        </p>
        <a class="text-link" href="/about/">
          See the people side of the work <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>
<style>
  @keyframes lab-pulse {
    0%,
    100% {
      transform: scaleX(0.22);
      opacity: 0.45;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
