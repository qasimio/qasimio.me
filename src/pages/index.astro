---
import Shell from '../layouts/Shell.astro';
import { getCollection } from 'astro:content';
import { site, timeline, professional } from '../data/site';
import qasim from '../assets/identity/qasim.jpg';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5);
---

<Shell current="home" title={`${site.name} — ${site.role}`}>
  <section class="page-section hero" id="top">
    <span class="eyebrow">ABOUT · {site.location}</span>
    <h1>
      I build <strong>software</strong>, then stay close enough to see what it becomes.
    </h1>
    <p class="hero-copy">
      I am Qasim Sethar. I build products, developer tools, AI systems, and small pieces of software
      that remove annoyances I cannot stop noticing. I care about the engineering, but also the part
      where someone else actually uses the thing.
    </p>
    <div class="hero-actions">
      <a class="btn btn-solid" href="/work/">
        See the work ↗
      </a>
      <a class="btn" href="/about/">
        More about me ↗
      </a>
    </div>
  </section>

  <section class="page-section reveal" id="about">
    <div class="section-head">
      <span class="section-num">01</span>
      <span class="section-title">About</span>
    </div>
    <div class="about-grid">
      <div class="about-photo-wrap">
        <img class="about-photo" src={qasim.src} alt="Qasim Sethar" />
      </div>
      <div class="copy-stack">
        <p>
          I'm a Computer Science student at <strong>{site.university}</strong> and spend a
          suspicious amount of my free time building software instead of using it normally.
        </p>
        <p>
          Some of the work is deep systems work. Some of it is tiny utility software. Some of it is
          organizing people around projects. The common thread is that I like owning the problem
          from “this is annoying” to “someone can use this.”
        </p>
        <p>
          I maintain <strong>FOLDR</strong>, build <strong>Engram</strong> and{' '}
          <strong>Operon</strong>, helped build <strong>SlotFinder</strong>, and created{' '}
          <strong>SIBA Launchpad</strong> to keep student work visible after the semester ends.
        </p>
        <div class="link-row">
          <a class="text-link" href="/about/">
            Read the longer version ↗
          </a>
          <a class="text-link" href="/resume.pdf">
            Résumé ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section reveal" id="proof">
    <div class="section-head">
      <span class="section-num">02</span>
      <span class="section-title">A little proof</span>
    </div>
    <div class="proof-grid">
      <div class="proof-item">
        <strong>100+</strong>
        <span>GitHub stars · FOLDR</span>
      </div>
      <div class="proof-item">
        <strong>7.3k+</strong>
        <span>tracked downloads · FOLDR</span>
      </div>
      <div class="proof-item">
        <strong>60+</strong>
        <span>student projects reviewed</span>
      </div>
      <div class="proof-item">
        <strong>35+</strong>
        <span>students and peers guided</span>
      </div>
      <div class="proof-item">
        <strong>24h</strong>
        <span>hackathon organized · Sibathon ’26</span>
      </div>
      <div class="proof-item">
        <strong>2</strong>
        <span>GitHub organizations maintained</span>
      </div>
    </div>
  </section>

  <section class="page-section reveal" id="now">
    <div class="section-head">
      <span class="section-num">03</span>
      <span class="section-title">Right now</span>
    </div>
    <div class="now-grid">
      {site.now.map(([label, value]) => (
        <div class="now-item">
          <small>{label}</small>
          <strong>{value}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section reveal" id="experience">
    <div class="section-head">
      <span class="section-num">04</span>
      <span class="section-title">The timeline</span>
    </div>
    <p class="work-intro">
      A chronological record of the turns that changed what I build. Not a résumé. More like a
      trail.
    </p>
    <div class="timeline">
      {timeline.map((item) => (
        <article class="timeline-item reveal">
          <span class="timeline-dot"></span>
          <time class="timeline-date">{item.date}</time>
          <h3 class="timeline-title">{item.title}</h3>
          <div class="timeline-place">{item.place}</div>
          <p class="timeline-copy">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section reveal" id="projects">
    <div class="section-head">
      <span class="section-num">05</span>
      <span class="section-title">Projects</span>
    </div>
    <p class="work-intro">The things I spent enough time on to deserve a page.</p>
    <div class="project-list" style="margin-top:25px">
      {featured.map((entry) => (
        <ProjectCard entry={entry} />
      ))}
    </div>
    <div class="hero-actions">
      <a class="btn" href="/work/">
        View all work ↗
      </a>
    </div>
  </section>

  <section class="page-section reveal" id="writing">
    <div class="section-head">
      <span class="section-num">06</span>
      <span class="section-title">Writing</span>
    </div>
    <p class="work-intro">
      Short notes when a thought is worth keeping. Longer writing when a subject refuses to fit in a
      paragraph.
    </p>
    <div class="notes" style="margin-top:20px">
      {notes.map((entry) => (
        <NoteRow entry={entry} />
      ))}
    </div>
    <div class="hero-actions">
      <a class="btn" href="/journal/">
        Open the journal ↗
      </a>
    </div>
  </section>

  <section class="page-section reveal" id="professional">
    <div class="section-head">
      <span class="section-num">07</span>
      <span class="section-title">Work outside my own repos</span>
    </div>
    <div class="experience">
      {professional.map((item, index) => (
        <article class="experience-row">
          <div class="experience-time">0{index + 1}</div>
          <div>
            <div class="experience-place">{item[0]}</div>
            <div class="experience-role">{item[1]}</div>
            <p class="experience-copy">{item[2]}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section reveal" id="contact">
    <div class="section-head">
      <span class="section-num">08</span>
      <span class="section-title">Contact</span>
    </div>
    <p class="hero-copy" style="max-width:48ch">
      If you are building something difficult, need another engineer in the room, or want to talk
      about a problem that has been annoying you for too long, email is easiest.
    </p>
    <div class="hero-actions">
      <a class="btn btn-solid" href={`mailto:${site.email}`}>
        Email {site.email} ↗
      </a>
      <a class="btn" href="/contact/">
        Contact page ↗
      </a>
    </div>
  </section>
</Shell>
