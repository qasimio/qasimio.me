---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Seo from '../components/Seo.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0c0f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('qasim-theme');
          const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <ClientRouter />
    <Seo title={title} description={description} noIndex={noIndex} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class="scroll-bar" data-scroll-progress></div>
    <SiteHeader />
    <main id="main-content" class="page-frame">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />

    <script is:inline>
      const bindSite = () => {
        const doc = document.documentElement;

        const updateScrollProgress = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const progress = max > 0 ? window.scrollY / max : 0;
          const bar = document.querySelector('[data-scroll-progress]');
          if (bar) bar.style.width = `${Math.min(100, Math.max(0, progress * 100))}%`;
          const header = document.querySelector('[data-site-header]');
          if (header) header.classList.toggle('is-scrolled', window.scrollY > 12);
        };

        if (!window.__qasimScrollBound) {
          window.__qasimScrollBound = true;
          window.addEventListener('scroll', updateScrollProgress, { passive: true });
        }
        updateScrollProgress();

        document.querySelectorAll('[data-reveal]:not([data-bound])').forEach((element) => {
          element.dataset.bound = 'true';
          if (!('IntersectionObserver' in window)) {
            element.classList.add('is-visible');
            return;
          }
          const observer = new IntersectionObserver(
            (entries, currentObserver) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                currentObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -7% 0px' },
          );
          observer.observe(element);
        });

        document.querySelectorAll('[data-theme-toggle]:not([data-bound])').forEach((button) => {
          button.dataset.bound = 'true';
          button.addEventListener('click', () => {
            const next = doc.dataset.theme === 'light' ? 'dark' : 'light';
            doc.dataset.theme = next;
            try {
              localStorage.setItem('qasim-theme', next);
            } catch {
              // Theme still changes for the current session when storage is unavailable.
            }
            const meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', next === 'light' ? '#f5f3ed' : '#0b0c0f');
            document.querySelectorAll('[data-theme-label]').forEach((label) => {
              label.textContent = next === 'light' ? 'Dark' : 'Light';
            });
          });
        });

        document.querySelectorAll('[data-menu-toggle]:not([data-bound])').forEach((button) => {
          button.dataset.bound = 'true';
          const mobileNav = document.querySelector('[data-mobile-nav]');
          button.addEventListener('click', () => {
            if (!mobileNav) return;
            const open = button.getAttribute('aria-expanded') === 'true';
            button.setAttribute('aria-expanded', String(!open));
            if (open) mobileNav.setAttribute('hidden', '');
            else mobileNav.removeAttribute('hidden');
            doc.classList.toggle('nav-open', !open);
          });
          mobileNav?.querySelectorAll('a').forEach((link) =>
            link.addEventListener('click', () => {
              button.setAttribute('aria-expanded', 'false');
              mobileNav.setAttribute('hidden', '');
              doc.classList.remove('nav-open');
            }),
          );
        });

        const contactForm = document.querySelector('[data-contact-form]');
        if (contactForm && !contactForm.dataset.bound) {
          contactForm.dataset.bound = 'true';
          contactForm.addEventListener('submit', (event) => {
            event.preventDefault();
            const form = new FormData(contactForm);
            const name = String(form.get('name') ?? '').trim();
            const email = String(form.get('email') ?? '').trim();
            const message = String(form.get('message') ?? '').trim();
            const subject = encodeURIComponent(`Hello Qasim${name ? ` — ${name}` : ''}`);
            const body = encodeURIComponent(
              `${message}\n\nFrom: ${name || 'Unknown'}\nEmail: ${email || 'Not provided'}`,
            );
            window.location.href = `mailto:hello@qasimio.me?subject=${subject}&body=${body}`;
          });
        }
      };

      document.addEventListener('astro:page-load', bindSite);
      bindSite();
    </script>
  </body>
</html>
