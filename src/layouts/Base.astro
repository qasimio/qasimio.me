---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#071114" data-theme-color />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={title} description={description} noIndex={noIndex} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('qasim-theme');
        const theme =
          saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <ClientRouter />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Qasim Sethar',
        alternateName: 'qasimio',
        url: 'https://qasimio.me',
        email: 'mailto:hello@qasimio.me',
        sameAs: [
          'https://github.com/qasimio',
          'https://linkedin.com/in/qasimio',
          'https://x.com/qasimiohq',
          'https://www.youtube.com/@qasimiohq',
        ],
      })}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="scroll-progress" data-scroll-progress></div>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />

    <script is:inline>
      const root = document.documentElement;
      const STORAGE = 'qasim-theme';
      const safeGet = (k) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const safeSet = (k, v) => {
        try {
          localStorage.setItem(k, v);
        } catch {}
      };
      const setTheme = (theme) => {
        const next = theme === 'light' ? 'light' : 'dark';
        root.dataset.theme = next;
        safeSet(STORAGE, next);
        document
          .querySelectorAll('[data-theme-label]')
          .forEach((el) => (el.textContent = next === 'dark' ? 'Light' : 'Dark'));
        const meta = document.querySelector('[data-theme-color]');
        if (meta) meta.setAttribute('content', next === 'dark' ? '#071114' : '#f2f0ea');
      };

      let palette = { items: [], active: 0 };
      const paletteEl = () => document.querySelector('[data-command-panel]');
      const inputEl = () => document.querySelector('[data-command-input]');
      const visibleItems = () => palette.items.filter((i) => !i.hasAttribute('hidden'));
      const renderPalette = () => {
        const items = visibleItems();
        items.forEach((item) => item.classList.remove('is-active'));
        if (!items.length) return;
        palette.active = Math.max(0, Math.min(palette.active, items.length - 1));
        items[palette.active].classList.add('is-active');
        items[palette.active].scrollIntoView({ block: 'nearest' });
      };
      const closePalette = () => {
        paletteEl()?.setAttribute('hidden', '');
        document.querySelector('[data-command-backdrop]')?.setAttribute('hidden', '');
        document.body.classList.remove('modal-open');
      };
      const openPalette = () => {
        const p = paletteEl();
        const input = inputEl();
        if (!p || !(input instanceof HTMLInputElement)) return;
        p.removeAttribute('hidden');
        document.querySelector('[data-command-backdrop]')?.removeAttribute('hidden');
        document.body.classList.add('modal-open');
        palette.items = [...document.querySelectorAll('[data-command-item]')];
        palette.active = 0;
        input.value = '';
        palette.items.forEach((i) => i.removeAttribute('hidden'));
        renderPalette();
        requestAnimationFrame(() => input.focus());
      };
      const init = () => {
        setTheme(
          safeGet(STORAGE) ||
            (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'),
        );
        const reveal = [...document.querySelectorAll('[data-reveal]:not(.is-visible)')];
        if ('IntersectionObserver' in window) {
          const ob = new IntersectionObserver(
            (entries) =>
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  ob.unobserve(e.target);
                }
              }),
            { threshold: 0.08, rootMargin: '0px 0px -10% 0px' },
          );
          reveal.forEach((el) => ob.observe(el));
        } else reveal.forEach((el) => el.classList.add('is-visible'));

        document.querySelectorAll('[data-theme-toggle]').forEach((b) => {
          if (b.dataset.bound) return;
          b.dataset.bound = '1';
          b.addEventListener('click', () =>
            setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'),
          );
        });
        document.querySelectorAll('[data-menu-toggle]').forEach((b) => {
          if (b.dataset.bound) return;
          b.dataset.bound = '1';
          b.addEventListener('click', () => {
            const menu = document.querySelector('[data-mobile-menu]');
            if (!menu) return;
            const open = menu.hasAttribute('hidden');
            menu.toggleAttribute('hidden', !open);
            b.setAttribute('aria-expanded', String(open));
          });
        });
        document.querySelectorAll('[data-command-open]').forEach((b) => {
          if (!b.dataset.bound) {
            b.dataset.bound = '1';
            b.addEventListener('click', openPalette);
          }
        });
        document.querySelectorAll('[data-command-close]').forEach((b) => {
          if (!b.dataset.bound) {
            b.dataset.bound = '1';
            b.addEventListener('click', closePalette);
          }
        });
        const input = inputEl();
        if (input && !input.dataset.bound) {
          input.dataset.bound = '1';
          input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            palette.items.forEach((item) =>
              item.toggleAttribute('hidden', !(item.textContent || '').toLowerCase().includes(q)),
            );
            palette.active = 0;
            renderPalette();
          });
        }
        document.querySelectorAll('[data-command-item]').forEach((item) => {
          if (item.dataset.bound) return;
          item.dataset.bound = '1';
          item.addEventListener('click', () => {
            const href = item.getAttribute('data-href');
            if (href) {
              closePalette();
              window.location.href = href;
            }
          });
        });
        document.querySelectorAll('[data-project-filter]').forEach((b) => {
          if (b.dataset.bound) return;
          b.dataset.bound = '1';
          b.addEventListener('click', () => {
            const value = b.getAttribute('data-project-filter') || 'all';
            document
              .querySelectorAll('[data-project-filter]')
              .forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            document
              .querySelectorAll('[data-project-item]')
              .forEach((item) =>
                item.toggleAttribute(
                  'hidden',
                  value !== 'all' && item.getAttribute('data-project-type') !== value,
                ),
              );
          });
        });
        document.querySelectorAll('[data-note-filter]').forEach((b) => {
          if (b.dataset.bound) return;
          b.dataset.bound = '1';
          b.addEventListener('click', () => {
            const value = b.getAttribute('data-note-filter') || 'all';
            document
              .querySelectorAll('[data-note-filter]')
              .forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            document
              .querySelectorAll('[data-note-item]')
              .forEach((item) =>
                item.toggleAttribute(
                  'hidden',
                  value !== 'all' && item.getAttribute('data-note-type') !== value,
                ),
              );
          });
        });
        document.querySelectorAll('[data-contact-form]').forEach((form) => {
          if (form.dataset.bound) return;
          form.dataset.bound = '1';
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const d = new FormData(form);
            const subject = encodeURIComponent(
              `Hello Qasim — ${String(d.get('name') || '').trim()}`,
            );
            const body = encodeURIComponent(
              `${String(d.get('message') || '').trim()}\n\n— ${String(d.get('name') || '').trim()}\n${String(d.get('email') || '').trim()}`,
            );
            window.location.href = `mailto:hello@qasimio.me?subject=${subject}&body=${body}`;
          });
        });
        document.querySelectorAll('[data-lab-toggle]').forEach((b) => {
          if (b.dataset.bound) return;
          b.dataset.bound = '1';
          b.addEventListener('click', () => {
            const state = b.getAttribute('aria-pressed') === 'true';
            b.setAttribute('aria-pressed', String(!state));
            const out = b.closest('[data-lab-card]')?.querySelector('[data-lab-output]');
            if (out) out.textContent = state ? 'PREVIEW' : 'UNDO READY';
          });
        });
        if (!window.__qasimioKeyboardBound) {
          window.__qasimioKeyboardBound = true;
          document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              openPalette();
            }
            if (e.key === 'Escape') {
              closePalette();
            }
            if (paletteEl() && !paletteEl().hasAttribute('hidden')) {
              const items = visibleItems();
              if (e.key === 'ArrowDown') {
                e.preventDefault();
                palette.active = (palette.active + 1) % items.length;
                renderPalette();
              }
              if (e.key === 'ArrowUp') {
                e.preventDefault();
                palette.active = (palette.active - 1 + items.length) % items.length;
                renderPalette();
              }
              if (e.key === 'Enter' && items[palette.active]) {
                e.preventDefault();
                items[palette.active].click();
              }
            }
          });
        }
      };
      const progress = () => {
        const el = document.querySelector('[data-scroll-progress]');
        if (!el) return;
        const max = document.documentElement.scrollHeight - innerHeight;
        el.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      };
      addEventListener('scroll', progress, { passive: true });
      addEventListener('load', init);
      document.addEventListener('astro:page-load', init);
      progress();
    </script>
  </body>
</html>
