---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}
const { title, description, noIndex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={title} description={description} noIndex={noIndex} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-bar" data-scroll-progress></div>
    <SiteHeader />
    <CommandPalette />
    <main id="main-content"><slot /></main>
    <SiteFooter />

    <script is:inline>
      const bindSite = () => {
        const doc = document.documentElement;

        const updateScroll = () => {
          const progress = document.querySelector('[data-scroll-progress]');
          const header = document.querySelector('[data-site-header]');
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const percent = max > 0 ? (window.scrollY / max) * 100 : 0;
          if (progress) progress.style.width = `${percent}%`;
          if (header) header.classList.toggle('is-scrolled', window.scrollY > 20);
        };

        if (!window.__qasimScrollBound) {
          window.__qasimScrollBound = true;
          window.addEventListener('scroll', updateScroll, { passive: true });
          window.addEventListener('resize', updateScroll, { passive: true });
        }
        updateScroll();

        document.querySelectorAll('[data-reveal]:not([data-reveal-ready])').forEach((element) => {
          element.setAttribute('data-reveal-ready', 'true');
          if (!('IntersectionObserver' in window)) {
            element.classList.add('is-visible');
            return;
          }
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.06 });
          observer.observe(element);
        });

        const menuButton = document.querySelector('[data-menu-toggle]');
        const mobileNav = document.querySelector('[data-mobile-nav]');
        if (menuButton && mobileNav && !menuButton.dataset.bound) {
          menuButton.dataset.bound = 'true';
          menuButton.addEventListener('click', () => {
            const open = menuButton.getAttribute('aria-expanded') === 'true';
            menuButton.setAttribute('aria-expanded', String(!open));
            if (open) mobileNav.setAttribute('hidden', '');
            else mobileNav.removeAttribute('hidden');
            doc.classList.toggle('nav-open', !open);
          });
          mobileNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
            menuButton.setAttribute('aria-expanded', 'false');
            mobileNav.setAttribute('hidden', '');
            doc.classList.remove('nav-open');
          }));
        }

        const setupCommandPalette = () => {
          const overlay = document.querySelector('[data-command-overlay]');
          const input = document.querySelector('[data-command-input]');
          const openCommand = () => {
            const activeOverlay = document.querySelector('[data-command-overlay]');
            const activeInput = document.querySelector('[data-command-input]');
            if (!activeOverlay || !activeInput) return;
            activeOverlay.removeAttribute('hidden');
            doc.classList.add('command-open');
            activeInput.focus();
          };
          const closeCommand = () => {
            const activeOverlay = document.querySelector('[data-command-overlay]');
            if (!activeOverlay) return;
            activeOverlay.setAttribute('hidden', '');
            doc.classList.remove('command-open');
          };
          const bindButtons = () => {
            document.querySelectorAll('[data-command-open]:not([data-bound])').forEach((button) => {
              button.setAttribute('data-bound', 'true');
              button.addEventListener('click', openCommand);
            });
            document.querySelectorAll('[data-command-close]:not([data-bound])').forEach((element) => {
              element.setAttribute('data-bound', 'true');
              element.addEventListener('click', closeCommand);
            });
          };
          const bindInput = () => {
            const activeInput = document.querySelector('[data-command-input]');
            if (!activeInput || activeInput.dataset.bound) return;
            activeInput.dataset.bound = 'true';
            activeInput.addEventListener('input', () => {
              const query = activeInput.value.trim().toLowerCase();
              document.querySelectorAll('[data-command-item]').forEach((item) => {
                item.hidden = !query || !item.dataset.commandSearch.toLowerCase().includes(query);
                if (!query) item.hidden = false;
              });
            });
          };

          bindButtons();
          bindInput();

          if (!window.__qasimCommandBound) {
            window.__qasimCommandBound = true;
            document.addEventListener('keydown', (event) => {
              const activeOverlay = document.querySelector('[data-command-overlay]');
              const activeInput = document.querySelector('[data-command-input]');
              const activeItems = [...document.querySelectorAll('[data-command-item]:not([hidden])')];
              if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
                event.preventDefault();
                if (doc.classList.contains('command-open')) closeCommand();
                else openCommand();
                return;
              }
              if (!doc.classList.contains('command-open') || !activeOverlay || !activeInput) return;
              if (event.key === 'Escape') { event.preventDefault(); closeCommand(); return; }
              const activeIndex = Math.max(0, activeItems.findIndex((item) => item.classList.contains('is-active')));
              if (event.key === 'ArrowDown') {
                event.preventDefault();
                const next = Math.min(activeIndex + 1, activeItems.length - 1);
                activeItems.forEach((item, index) => item.classList.toggle('is-active', index === next));
              }
              if (event.key === 'ArrowUp') {
                event.preventDefault();
                const next = Math.max(activeIndex - 1, 0);
                activeItems.forEach((item, index) => item.classList.toggle('is-active', index === next));
              }
              if (event.key === 'Enter' && activeItems[activeIndex]) {
                event.preventDefault();
                activeItems[activeIndex].click();
              }
            });
          }

          if (overlay && !overlay.dataset.initialized) {
            overlay.dataset.initialized = 'true';
            openCommand();
            closeCommand();
          }
        };

        setupCommandPalette();
      };

      document.addEventListener('astro:page-load', bindSite);
      bindSite();
    </script>
  </body>
</html>
