---
import mark from '../assets/identity/mq-mark.png';
const pathname = Astro.url.pathname;
const links = [
  { label: 'Work', href: '/work/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'About', href: '/about/' },
];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="Qasim Sethar home">
      <span class="brand__mark">
        <img src={mark} alt="" />
      </span>
      <span class="brand__text">
        <strong>Qasim Sethar</strong>
        <span>/ qasimio</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {links.map((link) => {
        const active =
          pathname === link.href || (pathname.startsWith(link.href) && link.href !== '/');
        return (
          <a class:list={{ active }} href={link.href} aria-current={active ? 'page' : undefined}>
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="header-tools">
      <button
        class="header-tool header-command"
        type="button"
        data-command-open
        aria-label="Open command palette"
      >
        Ctrl K
      </button>
      <button class="header-tool" type="button" data-theme-toggle aria-label="Toggle theme">
        <span data-theme-label>Light</span>
      </button>
      <a class="header-tool header-tool--accent" href="/contact/">
        Talk ↗
      </a>
      <button
        class="menu-button"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        Menu
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="shell mobile-menu__inner">
      {links.map((link) => (
        <a href={link.href}>
          {link.label}
          <span>↗</span>
        </a>
      ))}
      <a href="/contact/">
        Contact<span>↗</span>
      </a>
      <a href="/resume.pdf" target="_blank" rel="noreferrer">
        Résumé<span>↗</span>
      </a>
    </div>
  </div>
</header>
