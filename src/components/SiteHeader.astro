---
import mark from '../assets/identity/mq-mark.png';
const pathname = Astro.url.pathname;
const links = [
  { label: 'Work', href: '/work/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'About', href: '/about/' },
];
---

<header class="site-header" data-site-header>
  <div class="site-shell header-inner">
    <a class="brand" href="/" aria-label="Qasim Sethar home">
      <span class="brand-mark">
        <img src={mark} alt="" />
      </span>
      <span class="brand-name">
        <b>Qasim Sethar</b>
        <span>/ qasimio</span>
      </span>
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {links.map((link) => {
        const active =
          pathname === link.href || (pathname.startsWith(link.href) && link.href !== '/');
        return (
          <a
            class:list={['nav-link', { active }]}
            href={link.href}
            aria-current={active ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="header-actions">
      <button class="header-chip" type="button" data-command-open aria-label="Open command palette">
        <span>Ctrl</span>K
      </button>
      <button
        class="header-chip icon-chip"
        type="button"
        data-theme-toggle
        aria-label="Switch theme"
      >
        <span class="theme-light">☼</span>
        <span class="theme-dark">◐</span>
      </button>
      <a class="header-talk" href="/contact/">
        Talk <span>↗</span>
      </a>
      <button
        class="mobile-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <i></i>
        <i></i>
        <span class="sr-only">Open navigation</span>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <div class="site-shell mobile-nav-inner">
      {links.map((link) => (
        <a href={link.href}>
          {link.label}
          <span>↗</span>
        </a>
      ))}
      <a href="/resume.pdf">
        Résumé<span>↗</span>
      </a>
      <a href="/contact/">
        Contact<span>↗</span>
      </a>
      <button type="button" data-theme-toggle>
        Switch theme<span>◐</span>
      </button>
      <button type="button" data-command-open>
        Command palette<span>Ctrl K</span>
      </button>
    </div>
  </div>
</header>
