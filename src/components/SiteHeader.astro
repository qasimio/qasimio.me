---
const pathname = Astro.url.pathname;
const links = [
  { label: 'Work', href: '/work/' },
  { label: 'Journal', href: '/journal/' },
  { label: 'About', href: '/about/' },
];
---
<header class="site-header" data-site-header>
  <div class="site-shell header-inner">
    <a class="brand" href="/" aria-label="Qasim Sethar home" transition:name="brand">
      <span class="brand-mark">MQ</span>
      <span class="brand-name">Qasim Sethar</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { active: pathname.startsWith(link.href) }]}
          aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="command-trigger" type="button" data-command-open aria-label="Open command menu">
        <span class="command-trigger__key">⌘ / Ctrl</span>K
      </button>
      <a class="header-contact" href="/contact/">Contact <span>↗</span></a>
    </div>

    <button class="menu-trigger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span class="sr-only">Open navigation</span>
      <i></i><i></i>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <div class="site-shell mobile-nav__inner">
      {links.map((link) => <a href={link.href}>{link.label}<span>↗</span></a>)}
      <a href="/contact/">Contact<span>↗</span></a>
      <button type="button" data-command-open>Command menu<span>⌘K</span></button>
    </div>
  </div>
</header>
