---
import { site } from '../data/site';
import Icons from './Icons.astro';
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__top">
      <div>
        <a class="footer__brand" href="/#top">
          Qasim Sethar.
        </a>
        <p>Building, shipping, learning, repeating.</p>
      </div>
      <div class="footer__group">
        <span class="footer__label">Navigate</span>
        <a href="/#about">About ↗</a>
        <a href="/#jobs">Experience ↗</a>
        <a href="/#projects">Work ↗</a>
        <a href="/#contact">Contact ↗</a>
      </div>
      <div class="footer__group">
        <span class="footer__label">Elsewhere</span>
        <div class="footer__social-icons">
          {site.socials.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.name}>
              <Icons name={item.icon} size={18} />
            </a>
          ))}
        </div>
      </div>
      <a class="footer__mail" href={`mailto:${site.email}`}>
        <Icons name="mail" size={18} /> {site.email}
      </a>
    </div>
    <div class="footer__bottom">
      <span>© 2026 Qasim Sethar</span>
      <span>Independent · Open source · Human-readable</span>
    </div>
  </div>
</footer>
