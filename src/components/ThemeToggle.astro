<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Toggle light mode"
  title="Toggle light mode"
>
  ◐
</button>
<script is:inline>
  const themeBoot = () => {
    const root = document.documentElement;
    const saved = localStorage.getItem('qasim-theme');
    if (saved === 'light') root.dataset.theme = 'light';
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = '1';
      button.addEventListener('click', () => {
        const light = root.dataset.theme === 'light';
        if (light) {
          delete root.dataset.theme;
          localStorage.setItem('qasim-theme', 'dark');
          button.setAttribute('aria-label', 'Toggle light mode');
        } else {
          root.dataset.theme = 'light';
          localStorage.setItem('qasim-theme', 'light');
          button.setAttribute('aria-label', 'Toggle dark mode');
        }
      });
    });
  };
  themeBoot();
  document.addEventListener('astro:page-load', themeBoot);
</script>
