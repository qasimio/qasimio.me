      stroke="currentColor"
      stroke-width={stroke}
      stroke-linejoin="round"
    />
    <path d="M10.5 9.7l4.4 2.3-4.4 2.3V9.7Z" fill="currentColor" />
  </svg>
)}
{name === 'mail' && (
  <svg {...common}>
    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width={stroke} />
    <path
      d="M4 7l8 6 8-6"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === 'external' && (
  <svg {...common}>
    <path
      d="M14 5h5v5M19 5l-8 8"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M19 13v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"
