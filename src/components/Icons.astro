---
const { name, size = 20, stroke = 1.8 } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  'aria-hidden': 'true',
  xmlns: 'http://www.w3.org/2000/svg',
};
---

{name === 'github' && (
  <svg {...common}>
    <path
      d="M9 19c-4.2 1.3-4.2-2.2-5.9-2.6M14.9 21v-3.4a3.4 3.4 0 0 0-.9-2.4c3 0 6.1-1.5 6.1-6.7a5.2 5.2 0 0 0-1.4-3.7 4.8 4.8 0 0 0-.1-3.7s-1.1-.4-3.7 1.4a12.6 12.6 0 0 0-6.8 0C5.6.9 4.5 1.5 4.5 1.5a4.8 4.8 0 0 0-.1 3.7A5.2 5.2 0 0 0 3 8.5c0 5.2 3.1 6.7 6.1 6.7a3.4 3.4 0 0 0-.9 2.4V21"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === 'linkedin' && (
  <svg {...common}>
    <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width={stroke} />
    <path
      d="M7 10v7M7 7.5v.01M11 17v-4a3 3 0 0 1 6 0v4M11 10v7"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
    />
  </svg>
)}
{name === 'x' && (
  <svg {...common}>
    <path
      d="M5 4l14 16M19 4L5 20"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
    />
  </svg>
)}
{name === 'youtube' && (
