<form class="contact-form" data-contact-form>
  <div class="field-row">
    <label>
      Name
      <input required type="text" name="name" autocomplete="name" placeholder="Your name" />
    </label>
    <label>
      Email
      <input
        required
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
      />
    </label>
  </div>
  <label>
    What are you working on?
    <textarea
      required
      name="message"
      rows="7"
      placeholder="A product, a bug, a collaboration, an odd idea…"
    ></textarea>
  </label>
  <button class="button-primary magnetic" type="submit">
    Compose email <span>↗</span>
  </button>
  <p class="form-note">
    This opens your mail client with everything filled in. No phone number gets exposed.
  </p>
</form>
