<form class="contact-form" data-contact-form>
  <div class="contact-form__row">
    <label>
      <span>Name</span>
      <input name="name" autocomplete="name" required placeholder="Your name" />
    </label>
    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
    </label>
  </div>
  <label>
    <span>What are you thinking about?</span>
    <textarea name="message" rows="5" required placeholder="A product, problem, collaboration, idea..." />
  </label>
  <button class="button button--solid" type="submit">Compose email <span>↗</span></button>
  <p class="contact-form__hint">The form opens your email client. Your number stays private.</p>
</form>
