---
interface Props {
  slug: string;
  mode?: 'card' | 'hero';
}
const { slug, mode = 'card' } = Astro.props;
---

<div
  class:list={['project-visual', `project-visual--${slug}`, `project-visual--${mode}`]}
  aria-hidden="true"
>
  {slug === 'engram' && (
    <div class="visual-engram">
      <div class="engram-orb">E</div>
      <i class="engram-ring r1"></i>
      <i class="engram-ring r2"></i>
      <i class="engram-ring r3"></i>
      <span class="v-tag t1">retrieval</span>
      <span class="v-tag t2">evidence</span>
      <span class="v-tag t3">context</span>
      <span class="v-tag t4">agent</span>
      <span class="v-path p1"></span>
      <span class="v-path p2"></span>
    </div>
  )}
  {slug === 'operon' && (
    <div class="visual-operon">
      <div class="op-top">
        <span>OPERON / VERIFY</span>
        <b>DISK = TRUTH</b>
      </div>
      <div class="op-code">
        <span>rename_symbol("old_name")</span>
        <em>→</em>
        <strong>rename_symbol("new_name")</strong>
      </div>
      <div class="op-checks">
        <div>
          <small>01 / AST</small>
          <b>VERIFIED</b>
        </div>
        <div>
          <small>02 / DISK</small>
          <b>SNAPSHOT MATCH</b>
        </div>
        <div>
          <small>03 / HUMAN</small>
          <b>APPROVAL GATE</b>
        </div>
      </div>
    </div>
  )}
  {slug === 'foldr' && (
    <div class="visual-foldr">
      <div class="foldr-ui">
        <div class="foldr-head">
          <span>FOLDR / PREVIEW</span>
          <b>READY</b>
        </div>
        {['screenshots', 'documents', 'invoices', 'duplicates'].map((item, i) => (
          <div class="foldr-row">
            <span>0{i + 1}</span>
            <b>{item}</b>
            <small>{i === 3 ? 'REVIEW' : 'READY'}</small>
          </div>
        ))}
        <div class="foldr-foot">
          <span>12 planned operations</span>
          <strong>UNDO READY</strong>
        </div>
      </div>
    </div>
  )}
  {slug === 'slotfinder' && (
    <div class="visual-slot">
      <div class="slot-head">
        <span>SLOT FINDER</span>
        <b>FALL 2026</b>
      </div>
      <div class="slot-input">
        Search course, section, room <span>⌕</span>
      </div>
      <div class="slot-grid">
        {['MON', 'TUE', 'WED', 'THU', 'FRI'].map((d) => (
          <span>{d}</span>
        ))}
      </div>
      <div class="slot-result">
        <b>CS-301</b>
        <span>10:00 · Lab 2</span>
      </div>
      <div class="slot-result">
        <b>SE-302</b>
        <span>13:00 · Room 14</span>
      </div>
    </div>
  )}
  {slug === 'launchpad' && (
    <div class="visual-launchpad">
      <div class="lp-head">
        <span>IBA LAUNCHPAD</span>
        <b>PUBLIC</b>
      </div>
      <div class="lp-center">
        <i>LP</i>
        <span class="a">projects</span>
        <span class="b">people</span>
        <span class="c">github</span>
        <span class="d">feedback</span>
      </div>
      <div class="lp-foot">
        <strong>SHOW THE WORK.</strong>
        <span>publish · discover · collaborate</span>
      </div>
    </div>
  )}
  {slug === 'devshelf' && (
    <div class="visual-devshelf">
      <div class="ds-head">
        <span>DEVSHELF</span>
        <b>INDEXED</b>
      </div>
      <div class="ds-query">retrieval</div>
      <div class="ds-lines">
        <i style="width:84%"></i>
        <i style="width:61%"></i>
        <i style="width:72%"></i>
        <i style="width:46%"></i>
      </div>
      <div class="ds-foot">positional inverted index · Trie prefix matching</div>
    </div>
  )}
  {slug === 'mqnotebook' && (
    <div class="visual-mq">
      <div class="mq-head">
        <span>MQNOTEBOOK</span>
        <b>LOCAL</b>
      </div>
      {['scan_001.pdf', 'notes.xlsx', 'slides.pptx'].map((f) => (
        <div class="mq-file">{f}</div>
      ))}
      <div class="mq-foot">
        <span>OCR</span>
        <span>RERANK</span>
        <span>RETRIEVE</span>
      </div>
    </div>
  )}
</div>
