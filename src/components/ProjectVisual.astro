---
interface Props {
  slug: string;
  compact?: boolean;
}
const { slug, compact = false } = Astro.props;
---

<div class:list={['project-art', `project-art--${slug}`, { compact }]} aria-hidden="true">
  {slug === 'foldr' && (
    <div class="art-foldr">
      <div class="art-window">
        <div class="art-window-bar">
          <i></i>
          <i></i>
          <i></i>
          <b>FOLDR / PREVIEW</b>
        </div>
        <div class="art-file-list">
          <div class="art-file-row">
            <span>01</span>
            <span>screenshots</span>
            <span>READY</span>
          </div>
          <div class="art-file-row">
            <span>02</span>
            <span>documents</span>
            <span>READY</span>
          </div>
          <div class="art-file-row">
            <span>03</span>
            <span>invoices</span>
            <span>READY</span>
          </div>
          <div class="art-file-row">
            <span>04</span>
            <span>duplicates</span>
            <span>REVIEW</span>
          </div>
        </div>
        <div class="art-window-foot">
          <span>12 planned operations</span>
          <strong>UNDO READY</strong>
        </div>
      </div>
    </div>
  )}

  {slug === 'engram' && (
    <div class="art-engram">
      <div class="art-ring art-ring--one"></div>
      <div class="art-ring art-ring--two"></div>
      <div class="art-core">E</div>
      <span class="node n1">memory</span>
      <span class="node n2">retrieval</span>
      <span class="node n3">evidence</span>
      <span class="node n4">agent</span>
      <span class="node n5">workspace</span>
      <div class="art-connector c1"></div>
      <div class="art-connector c2"></div>
      <div class="art-connector c3"></div>
      <div class="art-connector c4"></div>
    </div>
  )}

  {slug === 'operon' && (
    <div class="art-operon">
      <div class="art-code">
        <div class="art-code-head">
          <span>OPERON / REVIEW</span>
          <span>DISK = TRUTH</span>
        </div>
        <div class="code-row is-del">
          <b>-</b>
          <span>rename_symbol("old_name")</span>
        </div>
        <div class="code-row is-add">
          <b>+</b>
          <span>rename_symbol("new_name")</span>
        </div>
        <div class="verify-grid">
          <div class="verify-card">
            <span>01 / AST</span>
            <strong>VERIFIED</strong>
          </div>
          <div class="verify-card">
            <span>02 / DISK</span>
            <strong>SNAPSHOT MATCH</strong>
          </div>
          <div class="verify-card">
            <span>03 / HUMAN</span>
            <strong>APPROVAL GATE</strong>
          </div>
        </div>
      </div>
    </div>
  )}

  {slug === 'slot-finder' && (
    <div class="art-slotfinder">
      <div class="slot-shell">
        <div class="slot-head">
          <span>SIBA / FALL</span>
          <span>SEARCH RESULT</span>
        </div>
        <div class="slot-table">
          {Array.from({ length: 40 }).map((_, index) => (
            <span
              class:list={['slot-cell', { active: [3, 4, 11, 19, 20, 27, 35].includes(index) }]}
            ></span>
          ))}
        </div>
        <div class="slot-meta">
          <span>CS-302 / SECTION A</span>
          <strong>ROOM 12 · 11:00</strong>
        </div>
      </div>
    </div>
  )}

  {slug === 'siba-launchpad' && (
    <div class="art-launchpad">
      <div class="launch-surface">
        <div class="launch-title">IBA LAUNCHPAD / PROJECT ECOSYSTEM</div>
        <div class="launch-grid">
          <span>SHOWCASE</span>
          <span>PROJECTS</span>
          <span>COLLABORATE</span>
          <span>GUIDANCE</span>
        </div>
        <div class="launch-stat">
          <strong>60+</strong>
          <span>projects reviewed</span>
        </div>
      </div>
    </div>
  )}

  {slug === 'devshelf' && (
    <div class="art-devshelf">
      <div class="shelf-surface">
        <div class="shelf-title">DEVSHELF / FROM FIRST PRINCIPLES</div>
        <div class="shelf-query">
          search → <strong>information retrieval</strong>
        </div>
        <div class="shelf-index">
          <span>inverted_index</span>
          <span>positions</span>
          <span>prefix_trie</span>
          <span>offline_index</span>
        </div>
        <div class="shelf-speed">
          <strong>0.8ms</strong>
          <span>query path</span>
        </div>
      </div>
    </div>
  )}

  {slug === 'mqnotebook' && (
    <div class="art-notebook">
      <div class="note-stack">
        <div class="note-file note-file--one">report_2025.pdf</div>
        <div class="note-file note-file--two">slides.pptx</div>
        <div class="note-file note-file--three">data.xlsx</div>
        <div class="note-query">⌕ scanned pages + tables + presentation notes</div>
      </div>
    </div>
  )}
</div>
