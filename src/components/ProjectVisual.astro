---
interface Props {
  slug: string;
  mode?: 'card' | 'hero';
}
const { slug, mode = 'card' } = Astro.props;
---

<div class:list={['visual', `visual--${slug}`, `visual--${mode}`]} aria-hidden="true">
  {slug === 'foldr' && (
    <div class="window">
      <div class="window__bar">
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <span class="window__title">FOLDR / PREVIEW</span>
      </div>
      <div class="window__rows">
        {['Screenshots', 'Documents', 'Downloads', 'Duplicates'].map((item, i) => (
          <div class="window__row">
            <small>0{i + 1}</small>
            <b>{item}</b>
            <span>{i === 3 ? 'review' : 'ready'}</span>
          </div>
        ))}
      </div>
      <div class="window__footer">
        <b>12 planned operations</b>
        <span>undo ready</span>
      </div>
    </div>
  )}
  {slug === 'engram' && (
    <div class="engram-orbit">
      <span class="engram-core">E</span>
      <span class="engram-node engram-node--a">documents</span>
      <span class="engram-node engram-node--b">memory</span>
      <span class="engram-node engram-node--c">query</span>
      <span class="engram-node engram-node--d">answer</span>
    </div>
  )}
  {slug === 'operon' && (
    <div class="operon-terminal">
      <div class="operon-bar">
        <span>OPERON / VERIFY</span>
        <span style="margin-left:auto">DISK = TRUTH</span>
      </div>
      <div class="operon-line">
        <em>rename_symbol</em>(<strong>"old_name"</strong>) → <em>rename_symbol</em>(
        <strong>"new_name"</strong>)
      </div>
      <div class="operon-checks">
        <div>
          <small>AST</small>
          <b>PASS</b>
        </div>
        <div>
          <small>DISK</small>
          <b>MATCH</b>
        </div>
        <div>
          <small>HUMAN</small>
          <b>APPROVED</b>
        </div>
      </div>
    </div>
  )}
  {slug === 'slot-finder' && (
    <div class="window">
      <div class="window__bar">
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <span class="window__title">SLOT FINDER / FALL 2026</span>
      </div>
      <div class="window__rows">
        <div class="window__row">
          <small>SEARCH</small>
          <b>CS-301</b>
          <span>found</span>
        </div>
        <div class="window__row">
          <small>ROOM</small>
          <b>Lab 2</b>
          <span>10:00</span>
        </div>
        <div class="window__row">
          <small>SECTION</small>
          <b>CS-B</b>
          <span>today</span>
        </div>
      </div>
    </div>
  )}
  {slug === 'siba-launchpad' && (
    <div class="engram-orbit">
      <span class="engram-core">LP</span>
      <span class="engram-node engram-node--a">students</span>
      <span class="engram-node engram-node--b">projects</span>
      <span class="engram-node engram-node--c">github</span>
      <span class="engram-node engram-node--d">publish</span>
    </div>
  )}
  {slug === 'devshelf' && (
    <div class="window">
      <div class="window__bar">
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <span class="window__title">DEVSHELF / SEARCH</span>
      </div>
      <div class="window__rows">
        <div class="window__row">
          <small>QUERY</small>
          <b>retrieval</b>
          <span>fast</span>
        </div>
        {[86, 68, 74, 55].map((width) => (
          <div class="window__row">
            <small>DOC</small>
            <b
              style={`display:block;height:6px;background:var(--violet);width:${width}%;border-radius:999px`}
            ></b>
            <span>rank</span>
          </div>
        ))}
      </div>
    </div>
  )}
  {slug === 'mqnotebook' && (
    <div class="window">
      <div class="window__bar">
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <i class="window__dot"></i>
        <span class="window__title">MQNOTEBOOK / LOCAL</span>
      </div>
      <div class="window__rows">
        {['scan_001.pdf', 'notes.xlsx', 'slides.pptx'].map((file, i) => (
          <div class="window__row">
            <small>0{i + 1}</small>
            <b>{file}</b>
            <span>{i === 0 ? 'ocr' : 'ready'}</span>
          </div>
        ))}
      </div>
    </div>
  )}
</div>
