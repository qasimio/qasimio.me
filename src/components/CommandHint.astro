<div class="command-hint">Ctrl&nbsp;K</div>
<style>
  .command-hint {
    position: fixed;
    right: 28px;
    bottom: 26px;
    z-index: 25;
    padding: 7px 9px;
    border: 1px solid rgba(136, 146, 176, 0.18);
    border-radius: 5px;
    background: rgba(10, 25, 47, 0.8);
    backdrop-filter: blur(8px);
    color: #8892b0;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }
  @media (max-width: 700px) {
    .command-hint {
      right: 18px;
      bottom: 18px;
    }
  }
</style>
<script is:inline>
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      window.location.href = '/work/';
    }
  });
</script>
