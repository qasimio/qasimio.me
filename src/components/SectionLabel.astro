---
const { index, label, title, href, linkLabel = 'View all' } = Astro.props;
---
<div class="section-head" data-reveal>
  <div class="section-head__left">
    <span class="section-index">{index}</span>
    <h2>{title}</h2>
  </div>
  {href && <a class="section-link" href={href}>{linkLabel}<span>↗</span></a>}
</div>
