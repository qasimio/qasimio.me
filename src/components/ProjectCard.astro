---
import type { CollectionEntry } from 'astro:content';
const { entry } = Astro.props as { entry: CollectionEntry<'projects'> };
---

<a class="project-card reveal" href={`/work/${entry.id}/`} transition:name={`project-${entry.id}`}>
  <div class="project-visual" aria-hidden="true">
    <div class="project-window">
      <div class="project-window-bar">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="project-code">
        {entry.data.title.toUpperCase()} / SYSTEM &gt; type: {entry.data.type.toLowerCase()}
        &gt; status: {entry.data.status.toLowerCase()}
        &gt; tags: {entry.data.tags.slice(0, 3).join(' / ')}
        &gt; evidence_required = true
      </div>
    </div>
    <div class="project-side-label">{entry.data.eyebrow}</div>
  </div>
  <div class="project-content">
    <div class="project-meta">
      {entry.data.year} · {entry.data.type} · {entry.data.status}
    </div>
    <h3 class="project-title">{entry.data.title}</h3>
    <p class="project-summary">{entry.data.summary}</p>
    {entry.data.pullQuote && <p class="project-push">“{entry.data.pullQuote}”</p>}
    {entry.data.stats.length > 0 && (
      <div class="project-stats">
        {entry.data.stats.slice(0, 3).map((stat) => (
          <div class="project-stat">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    )}
    <div class="tags">
      {entry.data.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  </div>
</a>
