---
import ProjectVisual from './ProjectVisual.astro';
const { entry, featured = false } = Astro.props;
---
<a
  class:list={['project-card', { featured }]}
  href={`/work/${entry.id}/`}
  data-project-card
  data-type={entry.data.type}
  transition:name={`project-${entry.id}`}
>
  <ProjectVisual slug={entry.id} title={entry.data.title} compact={!featured} />
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{String(entry.data.year)}</span>
      <span>{entry.data.type.replace('-', ' ')}</span>
      <span>{entry.data.status}</span>
    </div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
    <div class="project-card__foot">
      <span>{entry.data.tags.slice(0, 3).join(' · ')}</span>
      <span class="project-card__arrow">↗</span>
    </div>
  </div>
</a>
