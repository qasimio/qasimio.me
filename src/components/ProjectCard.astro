---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  entry: CollectionEntry<'projects'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
---

<a
  class:list={['project-card', { featured }]}
  href={`/work/${entry.id}/`}
  transition:name={`project-${entry.id}`}
  data-project-card
  data-type={entry.data.type}
>
  <ProjectVisual slug={entry.id} compact={!featured} />
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{String(entry.data.year)}</span>
      <span>{entry.data.type.replace('-', ' ')}</span>
      <span>{entry.data.status}</span>
    </div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
    <div class="project-card__foot">
      <span>{entry.data.tags.slice(0, 4).join(' · ')}</span>
      <span class="project-card__arrow">↗</span>
    </div>
  </div>
</a>
