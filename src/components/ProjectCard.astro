---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  entry: CollectionEntry<'projects'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
---

<a
  class:list={['project-card', { featured }]}
  href={`/work/${entry.id}/`}
  data-project-card
  data-type={entry.data.type}
>
  <div class="project-card-visual">
    <ProjectVisual slug={entry.data.visual} />
  </div>
  <div class="project-card-body">
    <div class="project-card-meta">
      <span>{entry.data.year}</span>
      <span>{entry.data.type.replace('-', ' ')}</span>
      <span>{entry.data.status}</span>
    </div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.summary}</p>
    <div class="project-card-foot">
      <span>{entry.data.tags.slice(0, 4).join(' · ')}</span>
      <b>↗</b>
    </div>
  </div>
</a>
