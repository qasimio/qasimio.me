---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  entry: CollectionEntry<'projects'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const status =
  entry.data.status === 'active' || entry.data.status === 'ongoing'
    ? 'in progress'
    : entry.data.status;
---

<article class:list={['work-card', { 'work-card--hero': featured }]} data-reveal>
  <a
    class="work-card__media"
    href={`/work/${entry.id}/`}
    aria-label={`Open ${entry.data.title} case study`}
  >
    <ProjectVisual slug={entry.data.visual} />
  </a>
  <div class="work-card__body">
    <div class="work-card__meta">
      <span>
        {entry.data.year} · {entry.data.type.replace('-', ' ')}
      </span>
      <span>{status}</span>
    </div>
    <h3>
      <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
    </h3>
    <p>{entry.data.summary}</p>
    {entry.data.proof.length > 0 && (
      <div class="work-card__proof">
        {entry.data.proof.slice(0, 3).map((item) => (
          <span>
            <strong>{item.value}</strong>
            <small>{item.label}</small>
          </span>
        ))}
      </div>
    )}
    <div class="work-card__bottom">
      <span class="tags">{entry.data.tags.slice(0, 4).join(' · ')}</span>
      <a class="text-link" href={`/work/${entry.id}/`}>
        Case study <span>↗</span>
      </a>
    </div>
  </div>
</article>
