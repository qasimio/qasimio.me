---
import type { Project } from '../data/site';
import Icons from './Icons.astro';
const { project } = Astro.props as { project: Project };
---

<li class="project-card" data-reveal>
  <div class="project-card__top">
    <span class="project-card__type">{project.category}</span>
    <span class="project-card__year">{project.year}</span>
  </div>
  <h3>
    <a href={`/archive/${project.slug}/`}>{project.title}</a>
  </h3>
  <p>{project.description}</p>
  <ul>
    {project.tags.map((tag) => (
      <li>{tag}</li>
    ))}
  </ul>
  <div class="project-card__link">
    <a href={`/archive/${project.slug}/`}>
      Read <Icons name="arrow" size={16} />
    </a>
  </div>
</li>
