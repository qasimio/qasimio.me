---
import { site } from '../data/site';
import Icons from './Icons.astro';
---

<aside class="side-rail side-rail--left" aria-label="Social links">
  <ul>
    {site.socials.map((item) => (
      <li>
        <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.name}>
          <Icons name={item.icon} size={18} />
        </a>
      </li>
    ))}
  </ul>
  <span class="side-rail__line"></span>
</aside>
<aside class="side-rail side-rail--right" aria-label="Email">
  <a class="side-rail__email" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
    <span>{site.email}</span>
    <Icons name="mail" size={16} />
  </a>
  <span class="side-rail__line"></span>
</aside>
