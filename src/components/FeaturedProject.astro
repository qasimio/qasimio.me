---
import type { Project } from '../data/site';
import Icons from './Icons.astro';
import ProjectArt from './ProjectArt.astro';
const { project, reverse = false } = Astro.props as { project: Project; reverse?: boolean };
---

<article class:list={['featured-project', { 'featured-project--reverse': reverse }]}>
  <div class="featured-project__image" data-reveal>
    <a href={`/archive/${project.slug}/`} aria-label={`Open ${project.title}`}>
      <ProjectArt kind={project.visual} title={project.title} />
    </a>
  </div>
  <div class="featured-project__content" data-reveal>
    <p class="featured-project__overline">Featured project · {project.year}</p>
    <h3>
      <a href={`/archive/${project.slug}/`}>{project.title}</a>
    </h3>
    <div class="featured-project__description">
      <p>{project.description}</p>
    </div>
    <ul class="featured-project__tags">
      {project.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <div class="featured-project__links">
      {project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.title} on GitHub`}
        >
          <Icons name="github" size={20} />
        </a>
      )}
      {project.live && (
        <a
          href={project.live}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.title} live site`}
        >
          <Icons name="external" size={21} />
        </a>
      )}
      <a class="featured-project__read" href={`/archive/${project.slug}/`}>
        Case study <Icons name="arrow" size={18} />
      </a>
    </div>
  </div>
</article>
