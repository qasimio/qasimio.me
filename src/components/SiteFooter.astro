---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <p class="eyebrow eyebrow--teal">NEXT</p>
        <h2 class="footer-title">
          Have a hard problem?
          <br />
          <em>Bring the weird one.</em>
        </h2>
        <p class="footer-copy">
          I like systems that have an annoying edge, products that need a real user, and
          conversations that leave me with something new to build.
        </p>
        <a class="button button--primary" href="/contact/">
          Get in touch ↗
        </a>
      </div>
      <div class="footer-col">
        <span>Navigate</span>
        <a href="/work/">Work ↗</a>
        <a href="/journal/">Journal ↗</a>
        <a href="/about/">About ↗</a>
        <a href="/resume.pdf">Résumé ↗</a>
      </div>
      <div class="footer-col">
        <span>Elsewhere</span>
        {site.socials.slice(0, 6).map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label} ↗
          </a>
        ))}
      </div>
    </div>
    <div class="footer-bottom">
      <span>{site.email}</span>
      <span>© {new Date().getFullYear()} Qasim Sethar</span>
      <span>Built in public, one thing at a time.</span>
    </div>
  </div>
</footer>
