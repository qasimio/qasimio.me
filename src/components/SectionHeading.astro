---
interface Props {
  number: string;
  title: string;
  note?: string;
  href?: string;
  label?: string;
}
const { number, title, note, href, label = 'View all' } = Astro.props;
---

<div class="section-head">
  <div class="section-head__left">
    <span class="section-head__number">{number}</span>
    <h2>{title}</h2>
  </div>
  <div class="section-head__right">
    {note && <span>{note}</span>}
    {href && <a href={href}>{label} ↗</a>}
  </div>
</div>
