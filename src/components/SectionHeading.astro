---
interface Props {
  index?: string;
  title: string;
  linkLabel?: string;
  linkHref?: string;
}
const { index, title, linkLabel, linkHref } = Astro.props;
---
<div class="section-heading" data-reveal>
  <div class="section-heading__title">
    {index && <span class="section-index">{index}</span>}
    <h2>{title}</h2>
  </div>
  {linkLabel && linkHref && <a href={linkHref} class="text-link">{linkLabel} <span>↗</span></a>}
</div>
