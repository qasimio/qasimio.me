---
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'notes'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const date = entry.data.publishedAt.toLocaleDateString('en-US', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
});
---

<a
  class:list={['note-row', { featured }]}
  href={`/journal/notes/${entry.id}/`}
  data-note-item
  data-type={entry.data.type}
>
  <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
  <div class="note-row__main">
    <span>{entry.data.type}</span>
    <h3>{entry.data.title}</h3>
    {entry.data.tags.length > 0 && (
      <p>{entry.data.tags.map((tag: string) => `#${tag}`).join('  ')}</p>
    )}
  </div>
  <span class="note-row__arrow">↗</span>
</a>
