---
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'notes'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const date = entry.data.publishedAt.toLocaleDateString('en-US', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
});
---

<a class:list={['note-row', { featured }]} href={`/journal/notes/${entry.id}/`}>
  <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
  <div class="note-main">
    <span>{entry.data.type}</span>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.excerpt}</p>
  </div>
  <b>↗</b>
</a>
