---
const { note } = Astro.props;
---

<li class="note-row reveal">
  <time datetime={note.date}>{note.date}</time>
  <div>
    <span class="note-row__tag">{note.tag}</span>
    <h3>
      <a href={note.href}>{note.title}</a>
    </h3>
    <p>{note.excerpt}</p>
  </div>
  <a class="note-row__arrow" href={note.href} aria-label={`Read ${note.title}`}>
    ↗
  </a>
</li>
