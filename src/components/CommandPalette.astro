---
import { commandItems } from '../data/site';
---

<div class="command-overlay" data-command-overlay hidden>
  <div class="command-backdrop" data-command-close></div>
  <section class="command-panel" role="dialog" aria-modal="true" aria-label="Command palette">
    <div class="command-search">
      <span>⌕</span>
      <input
        type="search"
        data-command-input
        placeholder="Jump to…"
        aria-label="Search commands"
        autocomplete="off"
      />
      <kbd>ESC</kbd>
    </div>
    <div class="command-results" data-command-results>
      {commandItems.map((item) => (
        <a
          class="command-item"
          data-command-item
          data-command-search={`${item.label} ${item.group}`}
          href={item.href}
          {...(item.external ? { target: '_blank', rel: 'noreferrer' } : {})}
        >
          <span>
            <small>{item.group}</small>
            {item.label}
          </span>
          <b>↗</b>
        </a>
      ))}
    </div>
    <div class="command-footer">↑ ↓ move &nbsp; · &nbsp; ↵ open &nbsp; · &nbsp; Esc close</div>
  </section>
</div>
