---
import { commandItems } from '../data/site';
---

<div class="command-backdrop" data-command-backdrop hidden data-command-close></div>
<div
  class="command"
  data-command-panel
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Command palette"
>
  <div class="command__search">
    <input data-command-input type="search" placeholder="Go somewhere…" autocomplete="off" />
  </div>
  <div class="command__items">
    {commandItems.map((item) => (
      <button
        class="command__item"
        type="button"
        data-command-item
        data-href={item.href}
        data-external={item.external ? 'true' : 'false'}
      >
        <span>{item.label}</span>
        <small>{item.external ? '↗' : 'open'}</small>
      </button>
    ))}
  </div>
  <div class="command__hint">
    <span>↑ ↓ navigate</span>
    <span>↵ open · esc close</span>
  </div>
</div>
