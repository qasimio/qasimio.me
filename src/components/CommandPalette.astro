---
import { commandItems } from '../data/site';
---

<div class="command-overlay" data-command-overlay hidden>
  <div class="command-backdrop" data-command-close></div>
  <section
    class="command-palette"
    role="dialog"
    aria-modal="true"
    aria-label="Command menu"
    data-command-palette
  >
    <div class="command-search-row">
      <span class="command-symbol">⌕</span>
      <input
        type="text"
        placeholder="Go somewhere…"
        aria-label="Search commands"
        autocomplete="off"
        data-command-input
      />
      <kbd>ESC</kbd>
    </div>
    <div class="command-results" data-command-results>
      {commandItems.map((item, index) => (
        <a
          href={item.href}
          class="command-item"
          data-command-item
          data-command-search={`${item.label} ${item.group}`}
          data-index={index}
          {...(item.external ? { target: '_blank', rel: 'noreferrer' } : {})}
        >
          <span>
            <small>{item.group}</small>
            {item.label}
          </span>
          <span>↗</span>
        </a>
      ))}
    </div>
    <div class="command-hint">
      <span>↑↓</span> navigate <span>↵</span> open <span>Esc</span> close
    </div>
  </section>
</div>
