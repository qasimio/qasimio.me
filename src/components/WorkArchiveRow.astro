---
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
---

<a
  class="archive-row"
  href={`/work/${entry.id}/`}
  data-project-card
  data-type={entry.data.type}
  data-reveal
>
  <span class="archive-row__year">{String(entry.data.year)}</span>
  <span class="archive-row__title">{entry.data.title}</span>
  <span class="archive-row__type">{entry.data.type.replace('-', ' ')}</span>
  <span class="archive-row__summary">{entry.data.summary}</span>
  <span class="archive-row__arrow">↗</span>
</a>
