---
interface Props {
  slug: string;
  mode?: 'card' | 'hero';
}
const { slug, mode = 'card' } = Astro.props;
---

<div
  class:list={['project-visual', `project-visual--${slug}`, `project-visual--${mode}`]}
  aria-hidden="true"
>
  {slug === 'foldr' && (
    <div class="visual-shell visual-foldr">
      <div class="visual-top">
        <span>FOLDR / PREVIEW</span>
        <b>READY</b>
      </div>
      <div class="visual-list">
        {['Screenshots', 'Documents', 'Downloads', 'Duplicates'].map((item, i) => (
          <div>
            <small>0{i + 1}</small>
            <strong>{item}</strong>
            <span>{i === 3 ? 'review' : 'ready'}</span>
          </div>
        ))}
      </div>
      <div class="visual-bottom">
        <b>12 planned operations</b>
        <span>undo ready</span>
      </div>
    </div>
  )}
  {slug === 'engram' && (
    <div class="visual-shell visual-engram">
      <div class="visual-top">
        <span>ENGRAM / RETRIEVAL</span>
        <b>GROUNDED</b>
      </div>
      <div class="engram-map">
        <i class="engram-center">E</i>
        {['DOCUMENT', 'MEMORY', 'QUERY', 'SOURCE', 'ANSWER'].map((label, i) => (
          <span class={`engram-node engram-node--${i}`}>{label}</span>
        ))}
        <i class="engram-line l1"></i>
        <i class="engram-line l2"></i>
        <i class="engram-line l3"></i>
        <i class="engram-line l4"></i>
        <i class="engram-line l5"></i>
      </div>
      <div class="visual-bottom">
        <b>retrieve</b>
        <span>→ rerank → ground → answer</span>
      </div>
    </div>
  )}
  {slug === 'operon' && (
    <div class="visual-shell visual-operon">
      <div class="visual-top">
        <span>OPERON / VERIFY</span>
        <b>DISK = TRUTH</b>
      </div>
      <div class="visual-code">
        <span>
          rename_symbol(<em>"old_name"</em>)
        </span>
        <i>→</i>
        <strong>
          rename_symbol(<em>"new_name"</em>)
        </strong>
      </div>
      <div class="visual-checks">
        <div>
          <small>AST</small>
          <b>PASS</b>
        </div>
        <div>
          <small>DISK</small>
          <b>MATCH</b>
        </div>
        <div>
          <small>HUMAN</small>
          <b>APPROVED</b>
        </div>
      </div>
    </div>
  )}
  {slug === 'slot-finder' && (
    <div class="visual-shell visual-slot">
      <div class="visual-top">
        <span>SLOT FINDER</span>
        <b>FALL 2026</b>
      </div>
      <div class="slot-search">
        <span>CS-301</span>
        <i>⌕</i>
      </div>
      <div class="slot-days">
        {['MON', 'TUE', 'WED', 'THU', 'FRI'].map((day) => (
          <span>{day}</span>
        ))}
      </div>
      <div class="slot-result slot-result--one">
        <b>CS-301</b>
        <span>10:00 · Lab 2</span>
      </div>
      <div class="slot-result slot-result--two">
        <b>CS-326</b>
        <span>13:00 · Room 14</span>
      </div>
    </div>
  )}
  {slug === 'siba-launchpad' && (
    <div class="visual-shell visual-launchpad">
      <div class="visual-top">
        <span>IBA LAUNCHPAD</span>
        <b>PUBLIC</b>
      </div>
      <div class="launchpad-map">
        <i>LP</i>
        <span>students</span>
        <span>projects</span>
        <span>github</span>
        <span>feedback</span>
      </div>
      <div class="visual-bottom">
        <b>SHOW THE WORK.</b>
        <span>publish · discover · build</span>
      </div>
    </div>
  )}
  {slug === 'devshelf' && (
    <div class="visual-shell visual-devshelf">
      <div class="visual-top">
        <span>DEVSHELF</span>
        <b>INDEXED</b>
      </div>
      <div class="devshelf-query">retrieval</div>
      <div class="devshelf-lines">
        {[86, 68, 74, 55, 64].map((size) => (
          <i style={`width:${size}%`}></i>
        ))}
      </div>
      <div class="visual-bottom">
        <span>positional inverted index</span>
        <b>Trie</b>
      </div>
    </div>
  )}
  {slug === 'mqnotebook' && (
    <div class="visual-shell visual-mq">
      <div class="visual-top">
        <span>MQNOTEBOOK</span>
        <b>LOCAL</b>
      </div>
      {['scan_001.pdf', 'notes.xlsx', 'slides.pptx'].map((file) => (
        <div class="mq-file">
          <span>◼</span>
          {file}
        </div>
      ))}
      <div class="visual-bottom">
        <span>OCR</span>
        <span>RERANK</span>
        <span>RETRIEVE</span>
      </div>
    </div>
  )}
</div>
