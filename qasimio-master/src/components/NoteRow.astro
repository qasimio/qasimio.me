---
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'notes'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const date = entry.data.publishedAt.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<a
  class:list={['note-row', { 'note-row--featured': featured }]}
  href={`/journal/notes/${entry.id}/`}
  data-reveal
>
  <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
  <div class="note-row__body">
    <div class="note-row__type">{entry.data.type}</div>
    <h3>{entry.data.title}</h3>
    <p>{entry.data.excerpt}</p>
  </div>
  <span class="note-row__arrow">↗</span>
</a>
