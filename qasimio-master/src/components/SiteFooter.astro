---
import mark from '../assets/identity/mq-mark.png';
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div class="footer-statement">
      <p class="eyebrow eyebrow--coral">NEXT</p>
      <h2>
        Build something
        <br />
        <em>worth keeping.</em>
      </h2>
      <a class="button button--primary" href="/contact/">
        Start a conversation <span>↗</span>
      </a>
    </div>

    <div class="footer-main">
      <div class="footer-identity">
        <a href="/" class="footer-mark">
          <img src={mark} alt="Qasim Sethar mark" />
        </a>
        <div>
          <strong>Qasim Sethar</strong>
          <span>/ qasimio</span>
        </div>
        <p>Software · products · systems · communities</p>
      </div>

      <div class="footer-columns">
        <div>
          <span>Navigate</span>
          <a href="/work/">Work ↗</a>
          <a href="/journal/">Journal ↗</a>
          <a href="/about/">About ↗</a>
          <a href="/resume.pdf">Résumé ↗</a>
        </div>
        <div>
          <span>Elsewhere</span>
          {site.socials.slice(0, 4).map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer">
              {item.label} ↗
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>© {new Date().getFullYear()} Qasim Sethar</span>
      <span>Made on a keyboard.</span>
    </div>
  </div>
</footer>
