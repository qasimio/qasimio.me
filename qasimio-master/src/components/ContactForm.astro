<form class="contact-form" data-contact-form>
  <div class="form-kicker">Open channel</div>
  <div class="form-grid">
    <label>
      <span>Name</span>
      <input name="name" required autocomplete="name" placeholder="Your name" />
    </label>
    <label>
      <span>Email</span>
      <input
        name="email"
        required
        type="email"
        autocomplete="email"
        placeholder="you@example.com"
      />
    </label>
  </div>
  <label>
    <span>What are you building?</span>
    <textarea
      name="message"
      required
      rows="9"
      placeholder="A product, a system, a collaboration, a strange technical problem…"
    ></textarea>
  </label>
  <div class="form-actions">
    <button class="button button--primary" type="submit">
      Open email <span>↗</span>
    </button>
    <p>Your mail client opens with everything filled in. No number exposed. No list.</p>
  </div>
</form>
