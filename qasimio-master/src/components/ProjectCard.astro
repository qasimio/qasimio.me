---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
interface Props {
  entry: CollectionEntry<'projects'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const statusText = entry.data.status === 'active' ? 'in progress' : entry.data.status;
---

<article class:list={['project-card', { 'project-card--featured': featured }]} data-reveal>
  <a
    href={`/work/${entry.id}/`}
    class="project-card__visual"
    aria-label={`Open ${entry.data.title} case study`}
  >
    <ProjectVisual slug={entry.data.visual} />
  </a>

  <div class="project-card__content">
    <div class="project-card__eyebrow">
      <span>{entry.data.year}</span>
      <span>{entry.data.type.replace('-', ' ')}</span>
      <span class="status">
        <i></i>
        {statusText}
      </span>
    </div>

    <div class="project-card__title-row">
      <a href={`/work/${entry.id}/`}>
        <h3>{entry.data.title}</h3>
      </a>
      <span class="project-card__arrow">↗</span>
    </div>

    <p>{entry.data.summary}</p>

    {entry.data.proof.length > 0 && (
      <div class="project-card__proof">
        {entry.data.proof.slice(0, 3).map((item) => (
          <span>
            <strong>{item.value}</strong>
            {item.label}
          </span>
        ))}
      </div>
    )}

    <div class="project-card__footer">
      <span>{entry.data.tags.slice(0, 4).join(' · ')}</span>
      <a href={`/work/${entry.id}/`}>
        Read the case <span>↗</span>
      </a>
    </div>
  </div>
</article>
