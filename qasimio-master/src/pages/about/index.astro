---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import portrait from '../../assets/identity/qasim-portrait.jpg';
import { community, milestones, professional, programs, site, workStyle } from '../../data/site';
---

<Base
  title="About — Qasim Sethar"
  description="Qasim Sethar, the person behind the software, projects, communities, and experiments."
>
  <section class="shell page-hero">
    <div class="page-hero__meta">
      <span>03 / ABOUT</span>
      <span>THE PERSON BEHIND THE WORK</span>
    </div>
    <p class="eyebrow eyebrow--coral">THE HUMAN PART</p>
    <h1>
      There is more to <em>building.</em>
    </h1>
    <p class="page-hero__lede">
      Code is the part I happen to be good at. I am also learning how to choose problems, work with
      people, ship things publicly, and make the useful parts survive after the first version.
    </p>
  </section>

  <section class="shell about-intro">
    <div class="about-photo" data-reveal>
      <Image
        src={portrait}
        alt="Qasim Sethar"
        widths={[720, 960]}
        sizes="(max-width: 760px) 100vw, 44vw"
      />
      <span>SUKKUR · PAKISTAN · 2026</span>
    </div>
    <div class="about-statement" data-reveal>
      <p class="eyebrow">THE SHORT VERSION</p>
      <h2>
        I want enough control over the work to follow a problem all the way <em>down.</em>
      </h2>
      <p>
        I am a Computer Science student at Sukkur IBA University. Most of the things worth putting
        here started outside coursework and got more interesting once somebody else had to use them.
      </p>
      <p>
        That has pulled me toward open source, product work, communities, and the parts of
        engineering where there is no clean assignment sheet telling you what happens next.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" data-magnetic="6" href="/resume.pdf">
          Read the résumé <span>↗</span>
        </a>
        <a class="button button--outline" data-magnetic="4" href="/contact/">
          Contact <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="shell section">
    <SectionHeading index="01" title="How it got here" note="the short history" />
    <div class="milestone-list">
      {milestones.map((item) => (
        <article data-reveal>
          <span>{item.period}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="band-section">
    <div class="shell">
      <SectionHeading
        index="02"
        title="People changed the work"
        note="not everything worth building is software"
      />
      <div class="community-grid">
        {community.map((item) => (
          <article data-reveal>
            <strong>{item.value}</strong>
            <h3>{item.label}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="shell section">
    <SectionHeading index="03" title="Professional work" note="outside my own products" />
    <div class="professional-list">
      {professional.map((item) => (
        <article data-reveal>
          <span>{item.period}</span>
          <strong>{item.place}</strong>
          <div>
            <h3>{item.role}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section workstyle-section">
    <div class="workstyle-lead" data-reveal>
      <p class="eyebrow">04 / HOW I WORK</p>
      <h2>
        The tools are ordinary. <em>The workflow is not.</em>
      </h2>
      <p>
        I use Arch every day, Vim inside VS Code, and shortcuts before the mouse. None of that is a
        personality test. It is just the environment I have spent enough time in that the interface
        gets out of the way.
      </p>
    </div>
    <div class="workstyle-table" data-reveal>
      {workStyle.map((row) => (
        <div>
          <span>{row[0]}</span>
          <strong>{row[1]}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="shell section">
    <SectionHeading
      index="05"
      title="Programs and recognition"
      note="useful context, not trophies"
    />
    <div class="program-list">
      {programs.map((item) => (
        <article data-reveal>
          <span>PROGRAM</span>
          <strong>{item.label}</strong>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section">
    <SectionHeading index="06" title="Things I keep alive" note="public homes" />
    <div class="maintain-grid">
      <div>
        <span>ORGANIZATIONS</span>
        {site.organizations.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label} ↗
          </a>
        ))}
      </div>
      <div>
        <span>OPEN SOURCE</span>
        <a href="https://github.com/qasimio/foldr" target="_blank" rel="noreferrer">
          FOLDR · maintainer ↗
        </a>
        <a href="https://github.com/qasimio" target="_blank" rel="noreferrer">
          Other repositories ↗
        </a>
      </div>
    </div>
  </section>

  <section class="shell section">
    <SectionHeading index="07" title="Elsewhere" note="the rest of the internet" />
    <div class="elsewhere-grid">
      <div>
        <span>PRIMARY</span>
        {site.socials.slice(0, 4).map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label} ↗
          </a>
        ))}
      </div>
      <div>
        <span>SECONDARY</span>
        {site.socials.slice(4).map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer">
            {item.label} ↗
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="shell closing-section">
    <p class="eyebrow eyebrow--violet">08 / NEXT</p>
    <h2>
      Building deeper systems. <em>Learning how to reach people.</em>
    </h2>
    <a class="button button--primary" data-magnetic="7" href="/contact/">
      Talk to me <span>↗</span>
    </a>
  </section>
</Base>
