---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteRow from '../../components/NoteRow.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const filterTypes = ['all', ...new Set(notes.map((entry) => entry.data.type))];
---

<Base
  title="Journal — Qasim Sethar"
  description="Short notes, build logs, observations, achievements, and longer writing from Qasim Sethar."
>
  <section class="shell page-hero journal-hero">
    <div class="page-hero__meta">
      <span>02 / JOURNAL</span>
      <span>NOTES + ESSAYS</span>
    </div>
    <p class="eyebrow eyebrow--violet">A PUBLIC LOG</p>
    <h1>
      Things I don't want to <em>forget.</em>
    </h1>
    <p class="page-hero__lede">
      Short things I ship, notice, learn, break, argue with, or keep thinking about after the screen
      goes dark.
    </p>
  </section>

  <section class="shell section journal-list-section">
    <div class="section-heading">
      <div class="section-heading__left">
        <span>01</span>
        <h2>Notes</h2>
      </div>
      <div class="section-heading__right">
        <a href="/journal/rss.xml">RSS ↗</a>
      </div>
    </div>
    <div class="journal-filters">
      {filterTypes.map((type, index) => (
        <button type="button" data-note-filter={type} aria-pressed={index === 0}>
          {type.replace('-', ' ')}
        </button>
      ))}
    </div>
    <div class="note-list note-list--full">
      {notes.map((entry) => (
        <div data-note-item data-note-type={entry.data.type}>
          <NoteRow entry={entry} />
        </div>
      ))}
    </div>
  </section>

  <section class="shell section essays-section">
    <div class="section-heading">
      <div class="section-heading__left">
        <span>02</span>
        <h2>Essays</h2>
      </div>
      <div class="section-heading__right">
        <span>{essays.length ? 'longer reads' : 'no forced publishing'}</span>
      </div>
    </div>
    {essays.length ? (
      <div class="essay-list">
        {essays.map((entry) => (
          <a href={`/journal/essays/${entry.id}/`}>
            <span>
              {entry.data.publishedAt.toLocaleDateString('en-US', {
                month: 'short',
                year: 'numeric',
              })}
            </span>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <b>↗</b>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-writing">
        <p>I will write something long when the short version stops being enough.</p>
      </div>
    )}
  </section>
</Base>
