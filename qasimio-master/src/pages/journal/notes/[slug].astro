---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.publishedAt.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const shareUrl = encodeURIComponent(`https://qasimio.me/journal/notes/${entry.id}/`);
const shareText = encodeURIComponent(entry.data.title);
---

<Base title={`${entry.data.title} — Journal`} description={entry.data.excerpt}>
  <article class="shell note-page">
    <div class="note-page__top">
      <span>JOURNAL / {entry.data.type}</span>
      <time datetime={entry.data.publishedAt.toISOString()}>{date}</time>
    </div>
    <header class="note-page__head">
      <p class="eyebrow eyebrow--violet">{entry.data.type}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.excerpt}</p>
      {entry.data.tags.length > 0 && (
        <div class="note-page__tags">
          {entry.data.tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="note-page__body">
      <div class="prose">
        <Content />
      </div>
    </div>
    <footer class="note-page__footer">
      <a class="text-link" href="/journal/">
        ← Journal
      </a>
      <div style="display:flex;gap:1.2rem;align-items:center;flex-wrap:wrap;">
        <button class="text-button" type="button" data-copy-link>
          Copy link
        </button>
        <a
          class="text-link"
          href={`https://x.com/intent/post?text=${shareText}&url=${shareUrl}`}
          target="_blank"
          rel="noreferrer"
        >
          Share on X <span>↗</span>
        </a>
      </div>
    </footer>
  </article>
</Base>
