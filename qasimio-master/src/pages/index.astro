---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import portrait from '../assets/identity/qasim-portrait.jpg';
import { capabilities, now, proof, principles } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((entry) => entry.data.featured).slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4);
---

<Base
  title="Qasim Sethar — qasimio"
  description="Qasim Sethar builds software, products, systems, and communities around difficult problems."
>
  <section class="hero shell">
    <div class="hero__meta">
      <span>QASIM SETHAR / QASIMIO</span>
      <span>SOFTWARE · PRODUCTS · SYSTEMS</span>
    </div>

    <div class="hero__grid">
      <div class="hero__copy" data-reveal>
        <p class="eyebrow">BUILDER / ENGINEER / MAKER</p>
        <h1>
          I build software until the problem stops looking <em>inevitable.</em>
        </h1>
        <p class="hero__lede">
          AI systems, search infrastructure, developer tools, and small products. Usually started
          because something was too annoying to leave alone.
        </p>
        <div class="hero__chips">
          <span>AI systems</span>
          <span>Search</span>
          <span>Developer tools</span>
          <span>Products</span>
        </div>
        <div class="hero__actions">
          <a class="button button--primary" data-magnetic="7" href="/work/">
            See the work <span>↗</span>
          </a>
          <a class="text-link" data-magnetic="4" href="/about/">
            Meet me <span>↗</span>
          </a>
        </div>
      </div>

      <div class="hero__portrait" data-reveal>
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt="Qasim Sethar"
            widths={[640, 880]}
            sizes="(max-width: 1180px) 640px, 520px"
          />
        </div>
        <div class="portrait-panel">
          <span>RIGHT NOW</span>
          <strong>
            Building.
            <br />
            Shipping.
            <br />
            Repeating.
          </strong>
          <small>Engram · Operon · Launchpad</small>
        </div>
        <div class="portrait-badge">Q</div>
      </div>
    </div>

    <div class="hero__bottom">
      <span>Scroll to explore</span>
      <span>01 / 07</span>
    </div>
  </section>

  <section class="hero-proof">
    <div class="shell hero-proof__grid">
      {proof.map((item) =>
        item.href ? (
          <a class="hero-proof__item" data-reveal href={item.href} target="_blank" rel="noreferrer">
            <strong class="hero-proof__number">{item.value}</strong>
            <span class="hero-proof__label">{item.label}</span>
            <small class="hero-proof__note">{item.note}</small>
          </a>
        ) : (
          <article class="hero-proof__item" data-reveal>
            <strong class="hero-proof__number">{item.value}</strong>
            <span class="hero-proof__label">{item.label}</span>
            <small class="hero-proof__note">{item.note}</small>
          </article>
        ),
      )}
    </div>
  </section>

  <section class="shell section now-section">
    <SectionHeading index="01" title="Right now" note="what has my attention" />
    <div class="now-grid">
      <div class="now-intro" data-reveal>
        <p class="eyebrow">CURRENTLY</p>
        <h2>
          Still making things. <em>Still finding the hard part.</em>
        </h2>
        <p>
          These are the projects taking most of my attention at the moment. Some are products. Some
          are infrastructure. One is a community that happens to have software around it.
        </p>
      </div>
      <div class="now-list">
        {now.map((item) => (
          <a class="now-row" href={item.href} data-reveal>
            <span class="now-row__number">{item.tag}</span>
            <span class="now-row__state">{item.state}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </div>
            <span class="now-row__arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="shell section work-section">
    <div class="section-heading">
      <div class="section-heading__left">
        <span>02</span>
        <h2>Selected work</h2>
      </div>
      <div class="section-heading__right">
        <span>built, shipped, or still being stubborn about</span>
        <a href="/work/">All work ↗</a>
      </div>
    </div>
    <div class="work-intro">
      <div>
        <p class="eyebrow">NO HOMEWORK FOLDER</p>
        <h2>
          Things that made it out of <em>my head.</em>
        </h2>
      </div>
      <p>
        Some of these became products. Some became systems. One exists because opening a timetable
        90 times is not a personality trait.
      </p>
    </div>
    <div class="featured-grid">
      {featured.map((entry, index) => (
        <ProjectCard entry={entry} featured={index === 0} />
      ))}
    </div>
  </section>

  <section class="statement-panel">
    <div class="shell statement-panel__grid">
      <div>
        <p class="eyebrow" style="color: var(--teal-ink);">
          A RULE I LIKE
        </p>
        <h2>
          Useful beats <em>impressive.</em>
        </h2>
      </div>
      <p class="statement-panel__copy">
        The interesting moment is after the demo. Somebody installs the thing, trusts it with
        something real, and notices when it is gone. That is the part I am trying to build toward.
      </p>
    </div>
  </section>

  <section class="shell section capabilities-section">
    <SectionHeading index="03" title="What I tend to build" note="the pattern, not a stack list" />
    <div class="principles-grid capabilities-grid">
      {capabilities.map((item) => (
        <article class="principle" data-reveal>
          <span class="principle__num">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section principles-section">
    <SectionHeading
      index="04"
      title="How I build"
      note="three rules I keep breaking, then relearning"
    />
    <div class="principles-grid">
      {principles.map((item, index) => (
        <article class="principle" data-reveal>
          <span class="principle__num">0{index + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section journal-home">
    <SectionHeading
      index="05"
      title="Journal"
      note="short things worth keeping"
      href="/journal/"
      linkLabel="Open journal"
    />
    <div class="journal-home__intro">
      <div>
        <p class="eyebrow eyebrow--violet">NOTES, NOT CONTENT MARKETING</p>
        <h2>
          I write things down before the feed <em>eats them.</em>
        </h2>
      </div>
      <p>
        Build notes, mistakes, launches, observations, links, and the occasional thing that has
        nothing to do with software.
      </p>
    </div>
    <div class="note-list">
      {notes.map((entry, index) => (
        <NoteRow entry={entry} featured={index === 0} />
      ))}
    </div>
  </section>

  <section class="people-panel">
    <div class="shell people-panel__grid">
      <div data-reveal>
        <p class="eyebrow eyebrow--coral">06 / OUTSIDE CODE</p>
        <h2>
          Some of the work is getting people to <em>press publish.</em>
        </h2>
      </div>
      <div class="people-panel__copy" data-reveal>
        <p>
          CS Society. Sibathon'26. SIBA Launchpad. Project reviews. Mentoring. Open-source
          maintenance.
        </p>
        <p>Those things taught me that software is often only half the problem.</p>
        <a class="text-link" href="/about/">
          See that side of the work <span>↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="shell closing-section">
    <p class="eyebrow eyebrow--coral">07 / CONTACT</p>
    <h2>
      Have a hard problem?
      <br />
      <em>Bring the weird one.</em>
    </h2>
    <a class="button button--primary" data-magnetic="7" href="/contact/">
      Get in touch <span>↗</span>
    </a>
  </section>
</Base>
