---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const index = projects.findIndex((item) => item.id === entry.id);
const related = projects
  .filter((item) => item.id !== entry.id)
  .slice(Math.max(0, index - 1), Math.max(0, index - 1) + 3);
const statusText = entry.data.status === 'active' ? 'in progress' : entry.data.status;
---

<Base title={`${entry.data.title} — Qasim Sethar`} description={entry.data.summary}>
  <article class="shell case">
    <div class="case-meta">
      <span>
        {String(entry.data.year)} / {entry.data.type.replace('-', ' ')}
      </span>
      <span>{entry.data.role}</span>
    </div>

    <header class="case-head">
      <div>
        <p class="case-kicker">{statusText} · case study</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
        <div class="case-actions">
          {entry.data.links.map((link) => (
            <a class="button button--outline" href={link.url} target="_blank" rel="noreferrer">
              {link.label} <span>↗</span>
            </a>
          ))}
        </div>
      </div>
      <aside class="case-aside">
        <span>TYPE</span>
        <strong>{entry.data.type.replace('-', ' ')}</strong>
        <span>STATUS</span>
        <strong>{statusText}</strong>
        <span>STACK</span>
        <strong>{entry.data.tags.join(' · ')}</strong>
      </aside>
    </header>

    <div class="case-visual">
      <ProjectVisual slug={entry.data.visual} mode="hero" />
    </div>

    {entry.data.stats.length > 0 && (
      <div class="case-stats">
        {entry.data.stats.map((stat) => (
          <div>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    )}

    {entry.data.proof.length > 0 && (
      <div class="case-proof">
        {entry.data.proof.map((item) => (
          <article>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </article>
        ))}
      </div>
    )}

    <div class="case-body">
      <aside class="case-body__rail">
        <span>CASE STUDY</span>
        {entry.data.pullQuote && <blockquote>“{entry.data.pullQuote}”</blockquote>}
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="case-end">
      <span class="eyebrow">KEEP GOING</span>
      <h2>More things I built.</h2>
      <div class="related-grid">
        {related.map((item) => (
          <a href={`/work/${item.id}/`}>
            <span>{item.data.type.replace('-', ' ')}</span>
            <strong>{item.data.title}</strong>
            <span>Read ↗</span>
          </a>
        ))}
      </div>
    </footer>
  </article>
</Base>
