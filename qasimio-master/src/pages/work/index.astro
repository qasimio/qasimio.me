---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((entry) => entry.data.featured).slice(0, 3);
const archive = projects.filter((entry) => !entry.data.featured);
const types = ['all', ...new Set(projects.map((entry) => entry.data.type))];
---

<Base
  title="Work — Qasim Sethar"
  description="Systems, products, developer tools, search engines, and community projects built by Qasim Sethar."
>
  <section class="shell page-hero">
    <div class="page-hero__meta">
      <span>01 / WORK</span>
      <span>{projects.length} builds</span>
    </div>
    <p class="eyebrow">THE THINGS THAT LEFT THE LAPTOP</p>
    <h1>
      Build it. Ship it. <em>Pressure-test it.</em>
    </h1>
    <p class="page-hero__lede">
      A collection of products, systems, tools, and experiments. The useful detail is not the stack.
      It is what broke, what changed, and whether anyone kept using the result.
    </p>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div class="section-heading__left">
        <span>01</span>
        <h2>Flagship work</h2>
      </div>
      <div class="section-heading__right">
        <span>start here</span>
      </div>
    </div>

    <div class="work-featured-grid" style="margin-top: 2rem;">
      {featured.map((entry, index) => (
        <article class:list={['work-feature', { 'work-feature--wide': index === 0 }]} data-reveal>
          <a
            class="work-feature__visual"
            href={`/work/${entry.id}/`}
            aria-label={`Open ${entry.data.title} case study`}
          >
            <ProjectVisual slug={entry.data.visual} mode="hero" />
          </a>
          <div class="work-feature__body">
            <div class="project-card__eyebrow">
              <span>{entry.data.year}</span>
              <span>{entry.data.type.replace('-', ' ')}</span>
              <span class="status">
                <i></i>
                {entry.data.status}
              </span>
            </div>
            <h2>
              <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.summary}</p>
            {entry.data.proof.length > 0 && (
              <div class="work-feature__proof">
                {entry.data.proof.slice(0, 3).map((item) => (
                  <span>
                    <strong>{item.value}</strong>
                    {item.label}
                  </span>
                ))}
              </div>
            )}
            <a class="text-link" href={`/work/${entry.id}/`}>
              Read the case <span>↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section archive-section">
    <div class="section-heading">
      <div class="section-heading__left">
        <span>02</span>
        <h2>The rest of the trail</h2>
      </div>
      <div class="section-heading__right">
        <span>older work still worth understanding</span>
      </div>
    </div>
    <div class="filter-bar">
      <div class="filters">
        {types.map((type, index) => (
          <button type="button" data-project-filter={type} aria-pressed={index === 0}>
            {type.replace('-', ' ')}
          </button>
        ))}
      </div>
      <span>Filter the archive.</span>
    </div>
    <div class="archive-list">
      {archive.map((entry) => (
        <a
          class="archive-row"
          data-project-card
          data-type={entry.data.type}
          href={`/work/${entry.id}/`}
        >
          <span>{String(entry.data.year)}</span>
          <strong>{entry.data.title}</strong>
          <span class="archive-row__type">{entry.data.type.replace('-', ' ')}</span>
          <p>{entry.data.summary}</p>
          <b>↗</b>
        </a>
      ))}
    </div>
  </section>
</Base>
