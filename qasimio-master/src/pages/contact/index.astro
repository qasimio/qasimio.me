---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Base
  title="Contact — Qasim Sethar"
  description="Contact Qasim Sethar about software, products, systems, collaborations, or difficult technical problems."
>
  <section class="shell contact-page">
    <div class="page-hero__meta">
      <span>04 / CONTACT</span>
      <span>OPEN CHANNEL</span>
    </div>
    <div class="contact-grid">
      <div data-reveal>
        <p class="eyebrow eyebrow--coral">TALK TO ME</p>
        <h1>
          Bring the weird <em>problem.</em>
        </h1>
        <p class="page-hero__lede">
          A product idea. A difficult system. A collaboration. Something you have tried three times
          already and still hate.
        </p>
        <div class="contact-direct">
          <a href="mailto:hello@qasimio.me">hello@qasimio.me ↗</a>
          <span>Sukkur, Pakistan · UTC+5</span>
        </div>
      </div>
      <div data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
