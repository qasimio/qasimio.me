---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a1515" data-theme-color />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={title} description={description} noIndex={noIndex} />

    <script is:inline>
      try {
        const saved = localStorage.getItem('qasim-theme');
        const preferred =
          saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = preferred;
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <ClientRouter />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Qasim Sethar',
        alternateName: 'qasimio',
        url: 'https://qasimio.me',
        email: 'mailto:hello@qasimio.me',
        sameAs: [
          'https://github.com/qasimio',
          'https://linkedin.com/in/qasimio',
          'https://x.com/qasimiohq',
          'https://www.youtube.com/@qasimiohq',
        ],
      })}
    ></script>
  </head>

  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="scroll-progress" data-scroll-progress></div>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
    <CommandPalette />

    <script is:inline>
      const root = document.documentElement;
      const globalKey = '__qasimioSiteBound';
      const storageKey = 'qasim-theme';
      let paletteState = { items: [], active: 0 };

      const safeStorageGet = (key) => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };

      const safeStorageSet = (key, value) => {
        try {
          localStorage.setItem(key, value);
        } catch {}
      };

      const applyTheme = (theme) => {
        const next = theme === 'light' ? 'light' : 'dark';
        root.dataset.theme = next;
        safeStorageSet(storageKey, next);
        document.querySelectorAll('[data-theme-icon]').forEach((el) => {
          el.textContent = next === 'dark' ? '☼' : '☾';
        });
        document.querySelectorAll('[data-theme-label]').forEach((el) => {
          el.textContent = next === 'dark' ? 'Light' : 'Dark';
        });
        const meta = document.querySelector('[data-theme-color]');
        if (meta) meta.setAttribute('content', next === 'dark' ? '#0a1515' : '#f2efe7');
      };

      const initTheme = () => {
        const saved = safeStorageGet(storageKey);
        const preferred =
          saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        applyTheme(preferred);
      };

      const closeMobileMenu = () => {
        const menu = document.querySelector('[data-mobile-menu]');
        const toggle = document.querySelector('[data-menu-toggle]');
        if (!menu || !toggle) return;
        menu.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      };

      const renderPalette = () => {
        const visible = paletteState.items.filter((item) => !item.hasAttribute('hidden'));
        visible.forEach((item) => item.classList.remove('is-active'));
        if (!visible.length) return;
        paletteState.active = Math.max(0, Math.min(paletteState.active, visible.length - 1));
        const active = visible[paletteState.active];
        active.classList.add('is-active');
        active.scrollIntoView({ block: 'nearest' });
      };

      const closePalette = () => {
        const palette = document.querySelector('[data-command]');
        if (!palette) return;
        palette.setAttribute('hidden', '');
        document.body.classList.remove('modal-open');
      };

      const openPalette = () => {
        const palette = document.querySelector('[data-command]');
        const input = document.querySelector('[data-command-input]');
        if (!palette || !(input instanceof HTMLInputElement)) return;
        palette.removeAttribute('hidden');
        document.body.classList.add('modal-open');
        paletteState.items = [...document.querySelectorAll('[data-command-item]')];
        paletteState.active = 0;
        input.value = '';
        paletteState.items.forEach((item) => item.removeAttribute('hidden'));
        renderPalette();
        requestAnimationFrame(() => input.focus());
      };

      const initReveal = () => {
        const items = [...document.querySelectorAll('[data-reveal]:not(.is-visible)')];
        if (!items.length) return;
        if (!('IntersectionObserver' in window)) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((item) => observer.observe(item));
      };

      const initFilters = () => {
        document.querySelectorAll('[data-project-filter]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.bound) return;
          button.dataset.bound = 'true';
          button.addEventListener('click', () => {
            const value = button.dataset.projectFilter || 'all';
            document.querySelectorAll('[data-project-filter]').forEach((item) => {
              item.setAttribute('aria-pressed', String(item === button));
            });
            document.querySelectorAll('[data-project-card]').forEach((card) => {
              card.toggleAttribute('hidden', value !== 'all' && card.dataset.type !== value);
            });
          });
        });

        document.querySelectorAll('[data-note-filter]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.bound) return;
          button.dataset.bound = 'true';
          button.addEventListener('click', () => {
            const value = button.dataset.noteFilter || 'all';
            document.querySelectorAll('[data-note-filter]').forEach((item) => {
              item.setAttribute('aria-pressed', String(item === button));
            });
            document.querySelectorAll('[data-note-item]').forEach((item) => {
              item.toggleAttribute('hidden', value !== 'all' && item.dataset.noteType !== value);
            });
          });
        });
      };

      const initContact = () => {
        document.querySelectorAll('[data-contact-form]').forEach((form) => {
          if (!(form instanceof HTMLFormElement) || form.dataset.bound) return;
          form.dataset.bound = 'true';
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const name = String(data.get('name') || '').trim();
            const email = String(data.get('email') || '').trim();
            const message = String(data.get('message') || '').trim();
            const subject = encodeURIComponent(`Hello Qasim — ${name}`);
            const body = encodeURIComponent(`Hi Qasim,\n\n${message}\n\n— ${name}\n${email}`);
            window.location.href = `mailto:hello@qasimio.me?subject=${subject}&body=${body}`;
          });
        });
      };

      const initMagnetic = () => {
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !window.matchMedia('(pointer:fine)').matches
        )
          return;
        document.querySelectorAll('[data-magnetic]').forEach((element) => {
          if (element.dataset.bound) return;
          element.dataset.bound = 'true';
          const strength = Number(element.dataset.magnetic || 8);
          element.addEventListener('pointermove', (event) => {
            const rect = element.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width - 0.5) * strength;
            const y = ((event.clientY - rect.top) / rect.height - 0.5) * strength;
            element.style.transform = `translate3d(${x}px, ${y}px, 0)`;
          });
          element.addEventListener('pointerleave', () => {
            element.style.transform = '';
          });
        });
      };

      const updateScrollProgress = () => {
        const progress = document.querySelector('[data-scroll-progress]');
        if (!progress) return;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
      };

      const initPage = () => {
        initTheme();
        initReveal();
        initFilters();
        initContact();
        initMagnetic();
        updateScrollProgress();

        document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.bound) return;
          button.dataset.bound = 'true';
          button.addEventListener('click', () =>
            applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'),
          );
        });

        document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.bound) return;
          button.dataset.bound = 'true';
          button.addEventListener('click', () => {
            const menu = document.querySelector('[data-mobile-menu]');
            if (!menu) return;
            const open = menu.hasAttribute('hidden');
            menu.toggleAttribute('hidden', !open);
            button.setAttribute('aria-expanded', String(open));
          });
        });

        document.querySelectorAll('[data-copy-link]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.bound) return;
          button.dataset.bound = 'true';
          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(window.location.href);
              button.textContent = 'Copied';
              window.setTimeout(() => {
                button.textContent = 'Copy link';
              }, 1200);
            } catch {
              button.textContent = 'Copy failed';
              window.setTimeout(() => {
                button.textContent = 'Copy link';
              }, 1200);
            }
          });
        });
      };

      if (!window[globalKey]) {
        window[globalKey] = true;

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('[data-command-open]')) openPalette();
          if (target.closest('[data-command-close]')) closePalette();
          if (target.closest('.mobile-menu a')) closeMobileMenu();
        });

        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            openPalette();
            return;
          }

          const palette = document.querySelector('[data-command]');
          if (!palette || palette.hasAttribute('hidden')) return;

          if (event.key === 'Escape') {
            closePalette();
            return;
          }

          const visible = paletteState.items.filter((item) => !item.hasAttribute('hidden'));
          if (!visible.length) return;

          if (event.key === 'ArrowDown') {
            event.preventDefault();
            paletteState.active = (paletteState.active + 1) % visible.length;
            renderPalette();
          }

          if (event.key === 'ArrowUp') {
            event.preventDefault();
            paletteState.active = (paletteState.active - 1 + visible.length) % visible.length;
            renderPalette();
          }

          if (event.key === 'Enter' && visible[paletteState.active]) {
            event.preventDefault();
            visible[paletteState.active].click();
          }
        });

        document.addEventListener('input', (event) => {
          const target = event.target;
          if (!(target instanceof HTMLInputElement) || !target.matches('[data-command-input]'))
            return;
          const query = target.value.trim().toLowerCase();
          paletteState.items.forEach((item) => {
            const haystack = (item.dataset.commandSearch || '').toLowerCase();
            item.toggleAttribute('hidden', Boolean(query) && !haystack.includes(query));
          });
          paletteState.active = 0;
          renderPalette();
        });

        window.addEventListener('scroll', updateScrollProgress, { passive: true });
      }

      initPage();
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
